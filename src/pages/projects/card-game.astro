---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { projects } from '../../data/projects';

const project = projects.find((p) => p.slug === 'card-game')!;
const { name, subtitle, description, tech, status } = project;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${name} - ${SITE_TITLE}`} description={subtitle} />
		<style>
			main {
				width: 860px;
			}
			.back-link {
				display: inline-block;
				margin-bottom: 1.5em;
				font-size: 0.9em;
			}
			h1 {
				margin-bottom: 0.3em;
			}
			.subtitle {
				color: rgb(var(--gray));
				font-size: 1.2em;
				margin-bottom: 1.5em;
			}
			.badge {
				display: inline-block;
				font-size: 0.8em;
				padding: 0.3em 0.9em;
				border-radius: 999px;
				margin-bottom: 1.5em;
				background: #fef3c7;
				color: #92400e;
				font-weight: 700;
			}
			h2 {
				font-size: 1.563em;
				margin-top: 1.5em;
			}
			.tech-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
			}
			.tag {
				font-size: 0.85em;
				padding: 0.3em 0.8em;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.notice {
				padding: 1em 1.2em;
				border-radius: 12px;
				background: #fffbeb;
				border: 1px solid #fde68a;
				color: #92400e;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="back-link" href="/projects/">← 返回作品集</a>
			<h1>{name}</h1>
			<p class="subtitle">{subtitle}</p>
			<span class="badge">开发中</span>

			<p>{description}</p>

			<div class="notice">
				该项目正在开发中，技术架构与海龟汤一致（WebSocket + Durable Objects），功能与截图后续补充。
			</div>

			<h2>技术栈</h2>
			<div class="tech-list">
				{tech.map((t) => (
					<span class="tag">{t}</span>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
