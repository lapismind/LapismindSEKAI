---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import SoupLobby from '../assets/soup-lobby.png';
import { projects } from '../data/projects';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const featured = projects.filter((p) => p.featured);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.hero {
				text-align: center;
				padding: 1.5em 0 2.5em;
			}
			.hero p.lead {
				font-size: 1.25em;
				color: rgb(var(--gray));
			}
			.section-title {
				font-size: 1.953em;
				margin: 0 0 1rem;
			}
			.card-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 1.5rem;
			}
			.project-card {
				background: white;
				border-radius: 16px;
				overflow: hidden;
				box-shadow: var(--box-shadow);
				text-decoration: none;
				display: block;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.project-card:hover {
				transform: translateY(-4px);
				box-shadow: 0 8px 32px rgba(var(--gray), 33%);
			}
			.project-card img {
				width: 100%;
				height: 180px;
				object-fit: cover;
				border-radius: 0;
				margin: 0;
			}
			.project-card .body {
				padding: 1em 1.2em 1.2em;
			}
			.project-card h4 {
				margin: 0 0 0.2em;
				color: rgb(var(--black));
			}
			.project-card .subtitle {
				margin: 0 0 0.6em;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.project-card .tech {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				margin-top: 0.6em;
			}
			.tag {
				font-size: 0.75em;
				padding: 0.2em 0.7em;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.status-badge {
				font-size: 0.7em;
				padding: 0.15em 0.6em;
				border-radius: 999px;
				margin-left: 0.5em;
				vertical-align: middle;
				font-weight: 700;
			}
			.status-online {
				background: #d1fae5;
				color: #065f46;
			}
			.status-developing {
				background: #fef3c7;
				color: #92400e;
			}
			.blog-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.blog-list li {
				border-bottom: 1px solid rgb(var(--gray-light));
				padding: 0.6em 0;
			}
			.blog-list li:last-child {
				border-bottom: none;
			}
			.blog-list a {
				text-decoration: none;
			}
			.blog-list .date {
				font-size: 0.8em;
				color: rgb(var(--gray));
				margin-left: 0.8em;
			}
			.more-link {
				display: inline-block;
				margin-top: 1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Hi, 我是 Lapismind 👋</h1>
				<p class="lead">
					前端开发者，热爱把想法做成能跑起来的东西。
					<br />
					这里是我的作品集与技术博客。
				</p>
			</section>

			<section>
				<h2 class="section-title">精选作品</h2>
				<div class="card-grid">
					{
						featured.map((p) => (
							<a class="project-card" href={`/projects/${p.slug}/`}>
								{p.slug === 'turtle-soup' && <Image src={SoupLobby} alt={`${p.name} 截图`} />}
								<div class="body">
									<h4>
										{p.name}
										<span class={`status-badge status-${p.status}`}>
											{p.status === 'online' ? '已上线' : '开发中'}
										</span>
									</h4>
									<p class="subtitle">{p.subtitle}</p>
									<p>{p.description}</p>
									<div class="tech">
										{p.tech.map((t) => (
											<span class="tag">{t}</span>
										))}
									</div>
								</div>
							</a>
						))
					}
				</div>
				<a class="more-link" href="/projects/">查看全部作品 →</a>
			</section>

			<section style="margin-top: 3em;">
				<h2 class="section-title">最新博客</h2>
				<ul class="blog-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.title}
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))
					}
				</ul>
				<a class="more-link" href="/blog/">全部文章 →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
