---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import DefaultOgImage from '../assets/site/og-card.jpg';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import ConsoleEasterEgg from './ConsoleEasterEgg.astro';

interface Props {
	title: string;
	description: string;
	/**
	 * 分享卡（og:image）的站内绝对路径。
	 *
	 * 收 URL 字符串而不是 ImageMetadata：直接用 `ImageMetadata.src` 会把**源文件**
	 * 发出去，而文章 hero 最大有 1.5MB PNG——抓取器要的只是几百 KB 的一张图。所以
	 * 文章页先用 `getImage()` 转成 1200 宽的小 jpg 再传进来；不传就用站点默认卡。
	 */
	imageUrl?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, imageUrl } = Astro.props;
const ogImage = new URL(imageUrl ?? DefaultOgImage.src, Astro.url);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- LXGW WenKai Screen（霞鹜文楷屏显），自托管，子集按需加载 -->
<link rel="stylesheet" href="/fonts/lxgwwenkaiscreen.css" />

<!-- 主题初始化：首帧前同步设置，避免闪白/闪黑；
     has-js 同时打上：入场动效的 opacity:0 只在有 JS 时才生效，
     脚本没跑起来时内容直接是最终态（见 design-kit base.css 的动效基元） -->
<script is:inline>
	document.documentElement.classList.add('has-js');
	(() => {
		try {
			const stored = localStorage.getItem('theme');
			const dark = stored
				? stored === 'dark'
				: window.matchMedia('(prefers-color-scheme: dark)').matches;
			document.documentElement.dataset.theme = dark ? 'dark' : 'light';
		} catch {
			document.documentElement.dataset.theme = 'light';
		}
	})();
</script>

<ClientRouter />

<!-- 控制台彩蛋：打开开发者工具可见 -->
<ConsoleEasterEgg />

<!-- 全局交互：滚动显隐 / 页头阴影 / 文章阅读进度 -->
<script>
	const sw = window as Window & { __snowCleanup?: () => void };
	function initGlobalBehaviors() {
		// 滚动显现
		const reveals = document.querySelectorAll('.reveal, .reveal-stagger');
		if ('IntersectionObserver' in window) {
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.08, rootMargin: '0px 0px -5% 0px' },
			);
			reveals.forEach((el) => {
				// 错峰容器：给直接子元素编号，CSS 用 --reveal-index × --stagger 排延迟。
				// 编号交给 JS 而不是 nth-child，是为了条目数变化时不用改 CSS。
				if (el.classList.contains('reveal-stagger')) {
					[...el.children].forEach((child, i) =>
						(child as HTMLElement).style.setProperty('--reveal-index', String(i)),
					);
				}
				io.observe(el);
			});
		} else {
			reveals.forEach((el) => el.classList.add('is-visible'));
		}

		// 图片淡入（img.img-fade）：解码完成后再淡入，避免硬闪。
		// 守卫写在元素自己身上（不是全局布尔）——ClientRouter 换页后新图片也要处理，
		// 而同一元素重复处理会导致动画重播（见 docs/lessons-learned.md 第 8 条同类问题）。
		for (const img of document.querySelectorAll<HTMLImageElement>('img.img-fade')) {
			if (img.classList.contains('is-loaded')) continue;
			const markLoaded = () => img.classList.add('is-loaded');
			if (img.complete && img.naturalWidth > 0) markLoaded();
			else {
				img.addEventListener('load', markLoaded, { once: true });
				img.addEventListener('error', markLoaded, { once: true });
			}
		}

		// 页头滚动状态
		const header = document.querySelector('header.site-header');
		const onScrollHeader = () => {
			if (!header) return;
			header.classList.toggle('scrolled', window.scrollY > 8);
		};
		onScrollHeader();
		window.addEventListener('scroll', onScrollHeader, { passive: true });

		// 阅读进度条
		const bar = document.querySelector('.reading-progress') as HTMLElement | null;
		if (bar) {
			const onScroll = () => {
				const doc = document.documentElement;
				const max = doc.scrollHeight - doc.clientHeight;
				bar.style.width = max > 0 ? `${(window.scrollY / max) * 100}%` : '0%';
			};
			onScroll();
			window.addEventListener('scroll', onScroll, { passive: true });
		}

		// 回到顶部按钮
		const topBtn = document.querySelector('.back-to-top') as HTMLElement | null;
		if (topBtn) {
			const onScrollTop = () => {
				const show = window.scrollY > 480;
				topBtn.classList.toggle('visible', show);
			};
			onScrollTop();
			window.addEventListener('scroll', onScrollTop, { passive: true });
			topBtn.onclick = () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			};
		}

		// 细雪飘落（真冬主题的轻量氛围，性能可控）
		const snowCanvas = document.querySelector('.snow-canvas') as HTMLCanvasElement | null;
		if (snowCanvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			if (sw.__snowCleanup) sw.__snowCleanup();
			const ctx = snowCanvas.getContext('2d')!;
			let raf = 0;
			let W = 0;
			let H = 0;
			let flakes: { x: number; y: number; r: number; s: number; drift: number; spd: number; a: number }[] = [];
			const count = Math.min(70, Math.max(20, Math.floor(window.innerWidth / 22)));
			const make = () => ({
				x: Math.random() * W,
				y: -10 - Math.random() * H,
				r: Math.random() * 2 + 0.7,
				s: Math.random() * 0.75 + 0.2,
				drift: Math.random() * Math.PI * 2,
				spd: Math.random() * 0.012 + 0.004,
				a: Math.random() * 0.4 + 0.2,
			});
			const resize = () => {
				W = snowCanvas.width = window.innerWidth;
				H = snowCanvas.height = window.innerHeight;
				flakes = Array.from({ length: count }, make);
			};
			const step = () => {
				ctx.clearRect(0, 0, W, H);
				for (const f of flakes) {
					f.y += f.s;
					f.drift += f.spd;
					const x = f.x + Math.sin(f.drift) * 20;
					if (f.y > H + 8) {
						Object.assign(f, make());
						f.y = -8;
					}
					ctx.beginPath();
					ctx.arc(x, f.y, f.r, 0, Math.PI * 2);
					ctx.fillStyle = `rgba(255,255,255,${f.a.toFixed(3)})`;
					ctx.fill();
				}
				if (!document.hidden) raf = requestAnimationFrame(step);
			};
			const onVis = () => {
				if (!document.hidden && !raf) raf = requestAnimationFrame(step);
			};
			const cleanup = () => {
				cancelAnimationFrame(raf);
				raf = 0;
				window.removeEventListener('resize', resize);
				document.removeEventListener('visibilitychange', onVis);
			};
			resize();
			window.addEventListener('resize', resize);
			document.addEventListener('visibilitychange', onVis);
			raf = requestAnimationFrame(step);
			sw.__snowCleanup = cleanup;
		}
	}

	document.addEventListener('astro:page-load', initGlobalBehaviors);
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{
	/* 默认卡是固定尺寸，声明出来让抓取器不必先下载；文章页的图尺寸随原图，不声明。 */
	imageUrl ? null : (
		<>
			<meta property="og:image:width" content={String(DefaultOgImage.width)} />
			<meta property="og:image:height" content={String(DefaultOgImage.height)} />
		</>
	)
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
