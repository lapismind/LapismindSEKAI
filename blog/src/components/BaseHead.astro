---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/soup-lobby.png';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import ConsoleEasterEgg from './ConsoleEasterEgg.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- LXGW WenKai Screen（霞鹜文楷屏显），自托管，子集按需加载 -->
<link rel="stylesheet" href="/fonts/lxgwwenkaiscreen.css" />

<!-- 主题初始化：首帧前同步设置，避免闪白/闪黑 -->
<script is:inline>
	(() => {
		try {
			const stored = localStorage.getItem('theme');
			const dark = stored
				? stored === 'dark'
				: window.matchMedia('(prefers-color-scheme: dark)').matches;
			document.documentElement.dataset.theme = dark ? 'dark' : 'light';
		} catch {
			document.documentElement.dataset.theme = 'light';
		}
	})();
</script>

<ClientRouter />

<!-- 控制台彩蛋：打开开发者工具可见 -->
<ConsoleEasterEgg />

<!-- 全局交互：滚动显隐 / 页头阴影 / 文章阅读进度 -->
<script>
	function initGlobalBehaviors() {
		// 滚动显现
		const reveals = document.querySelectorAll('.reveal');
		if ('IntersectionObserver' in window) {
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.08, rootMargin: '0px 0px -5% 0px' },
			);
			reveals.forEach((el) => io.observe(el));
		} else {
			reveals.forEach((el) => el.classList.add('is-visible'));
		}

		// 页头滚动状态
		const header = document.querySelector('header.site-header');
		const onScrollHeader = () => {
			if (!header) return;
			header.classList.toggle('scrolled', window.scrollY > 8);
		};
		onScrollHeader();
		window.addEventListener('scroll', onScrollHeader, { passive: true });

		// 阅读进度条
		const bar = document.querySelector('.reading-progress');
		if (bar) {
			const onScroll = () => {
				const doc = document.documentElement;
				const max = doc.scrollHeight - doc.clientHeight;
				bar.style.width = max > 0 ? `${(window.scrollY / max) * 100}%` : '0%';
			};
			onScroll();
			window.addEventListener('scroll', onScroll, { passive: true });
		}

		// 回到顶部按钮
		const topBtn = document.querySelector('.back-to-top');
		if (topBtn) {
			const onScrollTop = () => {
				const show = window.scrollY > 480;
				topBtn.classList.toggle('visible', show);
			};
			onScrollTop();
			window.addEventListener('scroll', onScrollTop, { passive: true });
			topBtn.onclick = () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			};
		}

		// 细雪飘落（真冬主题的轻量氛围，性能可控）
		const snowCanvas = document.querySelector('.snow-canvas');
		if (snowCanvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			if (window.__snowCleanup) window.__snowCleanup();
			const ctx = snowCanvas.getContext('2d');
			let raf = 0;
			let W = 0;
			let H = 0;
			let flakes = [];
			const count = Math.min(70, Math.max(20, Math.floor(window.innerWidth / 22)));
			const make = () => ({
				x: Math.random() * W,
				y: -10 - Math.random() * H,
				r: Math.random() * 2 + 0.7,
				s: Math.random() * 0.75 + 0.2,
				drift: Math.random() * Math.PI * 2,
				spd: Math.random() * 0.012 + 0.004,
				a: Math.random() * 0.4 + 0.2,
			});
			const resize = () => {
				W = snowCanvas.width = window.innerWidth;
				H = snowCanvas.height = window.innerHeight;
				flakes = Array.from({ length: count }, make);
			};
			const step = () => {
				ctx.clearRect(0, 0, W, H);
				for (const f of flakes) {
					f.y += f.s;
					f.drift += f.spd;
					const x = f.x + Math.sin(f.drift) * 20;
					if (f.y > H + 8) {
						Object.assign(f, make());
						f.y = -8;
					}
					ctx.beginPath();
					ctx.arc(x, f.y, f.r, 0, Math.PI * 2);
					ctx.fillStyle = `rgba(255,255,255,${f.a.toFixed(3)})`;
					ctx.fill();
				}
				if (!document.hidden) raf = requestAnimationFrame(step);
			};
			const onVis = () => {
				if (!document.hidden && !raf) raf = requestAnimationFrame(step);
			};
			const cleanup = () => {
				cancelAnimationFrame(raf);
				raf = 0;
				window.removeEventListener('resize', resize);
				document.removeEventListener('visibilitychange', onVis);
			};
			resize();
			window.addEventListener('resize', resize);
			document.addEventListener('visibilitychange', onVis);
			raf = requestAnimationFrame(step);
			window.__snowCleanup = cleanup;
		}
	}

	document.addEventListener('astro:page-load', initGlobalBehaviors);
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
