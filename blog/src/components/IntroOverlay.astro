---
// 进站开屏：25时碎球 + TAP TO START（Canvas 2D，零依赖）。
// 视觉规格与 _out/intro-demo 同源：四人代表色碎片聚成空心球悬停呼吸，
// 用户点按（或 6s 无操作自动）揭球——碎球绽开、四色光从球心渗出，进入 SEKAI。
// 出场纪律见脚本内注释。
---
<div class="intro" id="intro" aria-hidden="true">
	<canvas class="intro-canvas"></canvas>
	<div class="intro-title">
		<p class="intro-eyebrow">25時、ナイトコードで。</p>
		<p class="intro-tap">TAP TO START</p>
	</div>
</div>

<style is:global>
	.intro {
		position: fixed;
		inset: 0;
		z-index: 300;
		background: #0f0c1d;
		overflow: hidden;
		cursor: pointer;
		transition: opacity 1.1s ease;
	}
	.intro.exit {
		opacity: 0;
		pointer-events: none;
	}
	.intro.gone {
		display: none;
	}
	.intro-canvas {
		position: absolute;
		inset: 0;
		display: block;
	}
	.intro-title {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		pointer-events: none;
		padding: 0 3rem;
		gap: 3.2rem;
	}
	.intro-eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: clamp(0.9rem, 0.7rem + 0.5vw, 1.15rem);
		letter-spacing: 0.34em;
		color: #ece5ff;
		opacity: 0;
		transform: translateY(10px);
		filter: blur(6px);
		transition: opacity 1.1s ease, transform 1.1s ease, filter 1.1s ease;
		text-shadow: 0 0 22px oklch(0.8 0.1 290 / 0.75), 0 1px 10px oklch(0 0 0 / 0.5);
	}
	.intro.show .intro-eyebrow { opacity: 1; transform: none; filter: none; }
	.intro-tap {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.46em;
		text-indent: 0.46em;
		color: #d8e0ff;
		opacity: 0;
		transition: opacity 0.4s ease;
		text-shadow: 0 0 14px oklch(0.85 0.08 260 / 0.6);
	}
	.intro.ready .intro-tap {
		animation: intro-tap-breathe 2.2s ease-in-out infinite;
	}
	.intro.tapdone .intro-tap {
		animation: none;
		opacity: 0 !important;
	}
	@keyframes intro-tap-breathe {
		0%, 100% { opacity: 0.4; }
		50% { opacity: 1; }
	}
	@media (prefers-reduced-motion: reduce) {
		.intro { display: none; }
	}
</style>

<script>
	const w = window as Window & { __introDone?: boolean };

	// ---- 视觉常量（与 demo 同步） ----
	// 宵崎奏 / 朝比奈まふゆ / 東雲絵名 / 暁山瑞希（萌娘百科代表色）
	const MEMBERS = ['#bb6688', '#8888cc', '#ccaa88', '#ddaacc'];
	const SHARD_COLS = [...MEMBERS, ...MEMBERS, '#ffffff', '#9df5cf'];
	const T_FORM = 1.5;      // 碎球成形，进入悬停待点
	const T_EXPAND = 4.2;    // 揭球后缓散主时长
	const AUTO_REVEAL = 6.0; // 无操作自动揭球（含成形时间）

	type Shard = {
		u: number[]; jr: number; sz: number; rot: number; rv: number;
		col: string; st: number; sd: number[]; sdm: number;
		soft?: boolean; spr?: HTMLCanvasElement;
	};

	function runIntro() {
		const root = document.getElementById('intro');
		if (!root) return;
		const isHome = window.location.pathname.replace(/\/+$/, '') === '';
		let playedBefore = false;
		try {
			playedBefore = sessionStorage.getItem('lapismind-intro') === '1';
		} catch {}
		// 已在本页播过/正在播：只跳过，别删正在播的元素（runIntro 会被调用两次）
		if (w.__introDone) return;
		// 所有“不该播”的情况都统一走这里：跳过播放，并把元素清掉
		if (
			!isHome ||
			playedBefore ||
			window.matchMedia('(prefers-reduced-motion: reduce)').matches
		) {
			root.remove();
			return;
		}
		w.__introDone = true;
		try {
			sessionStorage.setItem('lapismind-intro', '1');
		} catch {}

		const canvas = root.querySelector<HTMLCanvasElement>('.intro-canvas')!;
		const ctx = canvas.getContext('2d')!;
		let W = 0, H = 0, CX = 0, CY = 0;
		const R = (a: number, b: number) => a + Math.random() * (b - a);
		const pick = <T,>(arr: T[]): T => arr[(Math.random() * arr.length) | 0];
		const clamp01 = (x: number) => Math.max(0, Math.min(1, x));
		const easeOutCubic = (x: number) => 1 - Math.pow(1 - x, 3);
		const easeInQuad = (x: number) => x * x;
		const easeInOutSine = (x: number) => -(Math.cos(Math.PI * x) - 1) / 2;
		const TAU = Math.PI * 2;

		// ---- 预渲染精灵：渐变与模糊烘焙到初始化，软件渲染环境也能锁 60fps ----
		const SPR: { blobs: Record<string, HTMLCanvasElement>; bg?: HTMLCanvasElement; white?: HTMLCanvasElement; lav?: HTMLCanvasElement } = { blobs: {} };
		function hexA(hex: string, a: number) {
			const r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);
			return `rgba(${r},${g},${b},${Math.max(0, Math.min(1, a))})`;
		}
		function makeBlob(hex: string, a: number) {
			const s = 256;
			const c = document.createElement('canvas');
			c.width = c.height = s;
			const g2 = c.getContext('2d')!;
			const g = g2.createRadialGradient(s / 2, s / 2, 0, s / 2, s / 2, s / 2);
			g.addColorStop(0, hexA(hex, a));
			g.addColorStop(0.5, hexA(hex, a * 0.42));
			g.addColorStop(1, hexA(hex, 0));
			g2.fillStyle = g;
			g2.fillRect(0, 0, s, s);
			return c;
		}
		function makeSoftShardSprite(col: string, size: number) {
			const pad = size * 0.85;
			const c = document.createElement('canvas');
			c.width = c.height = Math.ceil((size + pad) * 2);
			const g2 = c.getContext('2d')!;
			g2.translate(c.width / 2, c.height / 2);
			g2.filter = 'blur(6px)';
			g2.fillStyle = col;
			const tri = (k: number) => {
				g2.beginPath();
				g2.moveTo(0, -k);
				g2.lineTo(k * 0.9, k * 0.7);
				g2.lineTo(-k * 0.9, k * 0.55);
				g2.closePath();
				g2.fill();
			};
			g2.globalAlpha = 0.3;
			tri(size);
			g2.scale(1.35, 1.35);
			g2.globalAlpha = 0.17;
			tri(size);
			return c;
		}
		function buildSprites() {
			SPR.blobs = {};
			for (const col of MEMBERS) SPR.blobs[col] = makeBlob(col, 0.42);
			SPR.white = makeBlob('#f0fcff', 0.38);
			SPR.lav = makeBlob('#bea0f0', 0.16);
			const bg = document.createElement('canvas');
			bg.width = Math.max(1, W); bg.height = Math.max(1, H);
			const b2 = bg.getContext('2d')!;
			const g = b2.createRadialGradient(CX, CY, 0, CX, CY, Math.hypot(W, H) * 0.75);
			g.addColorStop(0, 'rgb(20,16,36)');
			g.addColorStop(1, 'rgb(15,12,29)');
			b2.fillStyle = g;
			b2.fillRect(0, 0, W, H);
			SPR.bg = bg;
		}
		function resize() {
			const scale = Math.min(devicePixelRatio || 1, 2);
			W = innerWidth; H = innerHeight;
			canvas.width = W * scale; canvas.height = H * scale;
			ctx.setTransform(scale, 0, 0, scale, 0, 0);
			CX = W / 2; CY = H * 0.46;
			buildSprites();
		}
		addEventListener('resize', onResize);
		function onResize() {
			resize();
		}
		resize();

		// ---- 场景状态 ----
		const r0 = () => Math.min(W, H) * 0.16;
		const randUnit = () => {
			const z = R(-1, 1), a = R(0, TAU), r = Math.sqrt(1 - z * z);
			return [r * Math.cos(a), r * Math.sin(a), z];
		};
		const ball: Shard[] = [];
		const n = { ball: 56, soft: 6, dust: 26 };
		for (let i = 0; i < n.ball; i++) {
			ball.push({
				u: randUnit(), jr: R(0.88, 1.16), sz: R(6.5, 18.5), rot: R(0, TAU), rv: R(-1.6, 1.6),
				col: pick(SHARD_COLS), st: R(0, 0.38), sd: randUnit(), sdm: R(2.3, 3.8),
			});
		}
		// 近景虚焦大碎片：朝向镜头的半球，制造纵深
		for (let i = 0; i < n.soft; i++) {
			const u = randUnit();
			u[2] = R(0.35, 0.95);
			const l = Math.hypot(...u);
			const col = pick(MEMBERS);
			const sz = R(38, 78);
			ball.push({
				u: u.map((v) => v / l), jr: R(1.08, 1.4), sz, soft: true,
				spr: makeSoftShardSprite(col, sz), rot: R(0, TAU), rv: R(-0.7, 0.7),
				col, st: R(0, 0.38), sd: randUnit(), sdm: R(2.3, 3.8),
			});
		}
		const dust = Array.from({ length: n.dust }, () => {
			const a = R(0, TAU), d = R(0.4, 0.7) * Math.hypot(W, H) / 2;
			return { a, d, sz: R(0.6, 1.8), v: R(0.7, 1.15), col: Math.random() < 0.7 ? '#bfe9ff' : pick(MEMBERS) };
		});
		// 彩光团：四色各一，中心按象限错开，揭球后从球心附近慢慢长出来
		const lights = MEMBERS.map((col, i) => ({
			col,
			dir: i * (TAU / 4) + R(-0.35, 0.35),
			off: R(0.75, 1.25),
			grow: R(1.5, 2.1),
			delay: i * 0.22,
			dur: R(3.2, 4.2),
			ph: R(0, TAU),
		}));

		const yaw0 = R(0, TAU);
		function ballRot(t: number) {
			const spin = 0.34;
			return { yaw: yaw0 + spin * t + t * t * 0.012, pitch: 0.32 + 0.1 * Math.sin(t * 0.7) };
		}
		function rotU(u: number[], rot: { yaw: number; pitch: number }) {
			const cy = Math.cos(rot.yaw), sy = Math.sin(rot.yaw);
			let x = u[0] * cy + u[2] * sy;
			let y = u[1];
			let z = -u[0] * sy + u[2] * cy;
			const cx = Math.cos(rot.pitch), sx = Math.sin(rot.pitch);
			const y2 = y * cx - z * sx;
			z = y * sx + z * cx;
			return [x, y2, z];
		}

		function drawBg(lightAmt: number) {
			ctx.drawImage(SPR.bg!, 0, 0, W, H);
			if (lightAmt > 0.01) {
				const r = Math.hypot(W, H) * 0.45;
				ctx.save();
				ctx.globalCompositeOperation = 'screen';
				ctx.globalAlpha = 0.1 * lightAmt;
				ctx.drawImage(SPR.white!, CX - r, CY - r, r * 2, r * 2);
				ctx.restore();
			}
		}
		function drawShardTri(x: number, y: number, size: number, rot: number, col: string, alpha: number, s: Shard) {
			if (alpha <= 0.015) return;
			ctx.save();
			ctx.translate(x, y);
			ctx.rotate(rot);
			if (s.soft && s.spr) {
				ctx.globalAlpha = alpha;
				ctx.drawImage(s.spr, -s.spr.width / 2, -s.spr.height / 2);
				ctx.restore();
				return;
			}
			ctx.globalAlpha = alpha * 0.88;
			ctx.fillStyle = col;
			ctx.beginPath();
			ctx.moveTo(0, -size);
			ctx.lineTo(size * 0.9, size * 0.7);
			ctx.lineTo(-size * 0.9, size * 0.55);
			ctx.closePath();
			ctx.fill();
			if (alpha > 0.3) {
				ctx.globalAlpha = alpha * 0.75;
				ctx.strokeStyle = '#ffffff';
				ctx.lineWidth = 1;
				ctx.stroke();
			}
			ctx.restore();
		}
		function drawLights(tr: number, mul: number, behind: boolean) {
			ctx.save();
			ctx.globalCompositeOperation = 'screen';
			for (const L of lights) {
				const p = easeInOutSine(clamp01((tr - L.delay) / L.dur));
				if (p <= 0) continue;
				const rad = r0() * (0.35 + L.grow * p);
				const ox = Math.cos(L.dir) * r0() * L.off * p;
				const oy = Math.sin(L.dir) * r0() * L.off * p;
				const breathe = 0.92 + 0.08 * Math.sin(tr * 0.7 + L.ph); // 十秒级缓摆，不闪
				ctx.globalAlpha = mul * p * breathe * (behind ? 1 : 0.25);
				ctx.drawImage(SPR.blobs[L.col], CX + ox - rad, CY + oy - rad, rad * 2, rad * 2);
			}
			ctx.restore();
		}

		// ---- 揭球音效：WebAudio 现场合成「渐入溅出」，无音频素材 ----
		// 噪声带通扫频（whoosh）+ 三枚正弦小水滴上行，主增益渐入。
		// AudioContext 必须在用户手势里创建/恢复——只挂在点按/键盘路径上，
		// 6s 无操作自动揭球走静音路径（无手势时浏览器禁止出声）。
		let audioCtx: AudioContext | null = null;
		function playSplash() {
			try {
				audioCtx ??= new AudioContext();
				if (audioCtx.state === 'suspended') audioCtx.resume();
				const t = audioCtx.currentTime;
				const master = audioCtx.createGain();
				master.gain.setValueAtTime(0.0001, t);
				master.gain.linearRampToValueAtTime(0.22, t + 0.12); // 渐入
				master.connect(audioCtx.destination);
				// whoosh：白噪声过带通，中心频率 400Hz → 3.5kHz 上扫
				const dur = 0.7;
				const buf = audioCtx.createBuffer(1, Math.floor(audioCtx.sampleRate * dur), audioCtx.sampleRate);
				const data = buf.getChannelData(0);
				for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
				const noise = audioCtx.createBufferSource();
				noise.buffer = buf;
				const bp = audioCtx.createBiquadFilter();
				bp.type = 'bandpass';
				bp.Q.value = 1.1;
				bp.frequency.setValueAtTime(400, t);
				bp.frequency.exponentialRampToValueAtTime(3500, t + 0.45);
				const ng = audioCtx.createGain();
				ng.gain.setValueAtTime(0.9, t);
				ng.gain.exponentialRampToValueAtTime(0.001, t + 0.65);
				noise.connect(bp);
				bp.connect(ng);
				ng.connect(master);
				noise.start(t);
				noise.stop(t + dur);
				// 水滴：三枚正弦，音高上行，指尖落点错开
				[880, 1174.7, 1568].forEach((f, i) => {
					const o = audioCtx!.createOscillator();
					o.type = 'sine';
					o.frequency.value = f;
					const g = audioCtx!.createGain();
					const st = t + 0.05 + i * 0.07;
					g.gain.setValueAtTime(0, st);
					g.gain.linearRampToValueAtTime(0.16, st + 0.02);
					g.gain.exponentialRampToValueAtTime(0.001, st + 0.3);
					o.connect(g);
					g.connect(master);
					o.start(st);
					o.stop(st + 0.35);
				});
			} catch {
				// 音频失败静默忽略：开屏不该因为声音挂掉
			}
		}

		// ---- 揭球交互：成形后即可点（点击 / 回车 / 空格），无操作 AUTO_REVEAL 自动揭 ----
		let revealedAt: number | null = null; // 以成形时刻为 0 的揭球秒数
		function reveal(now: number, withSound = false) {
			if (revealedAt !== null || now < T_FORM) return;
			revealedAt = now - T_FORM; // 缓散/渗光时间轴从成形时刻起算
			if (withSound) playSplash();
			root.classList.remove('ready');
			root.classList.add('tapdone');
			// 收场：揭球后播完缓散再整体淡出揭示主页
			setTimeout(() => root.classList.add('exit'), T_EXPAND * 1000 + 1100);
			setTimeout(() => {
				root.classList.add('gone');
				root.remove();
			}, T_EXPAND * 1000 + 2400);
			setTimeout(() => {
				cancelAnimationFrame(raf);
				removeEventListener('resize', onResize);
				window.removeEventListener('keydown', onKey);
			}, T_EXPAND * 1000 + 3600);
		}
		root.addEventListener('pointerdown', () => reveal((performance.now() - t0) / 1000, true));
		// 键盘事件挂 window（div 不可聚焦）；动画层已被清掉时不响应
		function onKey(ev: KeyboardEvent) {
			if (!root.isConnected) return;
			if (ev.code === 'Enter' || ev.code === 'Space') reveal((performance.now() - t0) / 1000, true);
		}
		window.addEventListener('keydown', onKey);

		// ---- 主循环 ----
		const t0 = performance.now();
		let last = t0;
		let raf = 0;
		let titleShown = false;
		let tapShown = false;
		const ambient: { x: number; y: number; v: number; sz: number; a: number; col: string; rot: number; rv: number }[] = [];
		function frame(now: number) {
			if (!root.isConnected) { cancelAnimationFrame(raf); return; } // 换页被清掉就停表
			const t = (now - t0) / 1000;
			const dt = Math.min(0.05, (now - last) / 1000);
			last = now;
			const revealed = revealedAt !== null;
			const tr = revealed ? t - T_FORM - revealedAt! : 0; // 揭球后经过的秒数
			const rot = ballRot(t);
			const forming = t < T_FORM;
			const fp = easeInQuad(clamp01(t / T_FORM));
			// 球壳半径：成形期收拢 → 悬停期呼吸 → 揭球后持续缓涨
			const idleBreathe = 0.05 * Math.sin((t - T_FORM) * 1.15);
			const shellR = forming
				? r0() * (1.06 - 0.22 * fp)
				: revealed
					? r0() * (0.84 + 2.2 * easeInOutSine(clamp01(tr / T_EXPAND)) + Math.max(0, tr - T_EXPAND) * 0.22)
					: r0() * (0.86 + idleBreathe);
			const lightAmt = revealed ? easeInOutSine(clamp01(tr / (T_EXPAND * 0.9))) : 0;

			ctx.save();
			const zoom = 1 + 0.04 * easeInOutSine(clamp01(t / (T_FORM + T_EXPAND * 0.6)));
			ctx.translate(CX, CY); ctx.scale(zoom, zoom); ctx.translate(-CX, -CY);

			drawBg(lightAmt);

			ctx.save();
			ctx.globalCompositeOperation = 'lighter';
			for (const d of dust) {
				const dd = d.d * (1 - easeInQuad(clamp01(t / T_FORM)) * d.v * 0.9) + tr * 14 * d.v;
				ctx.globalAlpha = (0.1 + 0.34 * fp) * Math.max(0.25, 1 - lightAmt * 0.5);
				ctx.fillStyle = d.col;
				ctx.beginPath();
				ctx.arc(CX + Math.cos(d.a) * dd, CY + Math.sin(d.a) * dd * 0.92, d.sz, 0, TAU);
				ctx.fill();
			}
			ctx.restore();

			// 中心辉光：成形期点亮，悬停期呼吸，揭球后随彩光接管而退场
			if (t >= T_FORM * 0.3) {
				const idleGlow = forming ? fp : 1;
				const cr = r0() * (0.25 + 1.05 * idleGlow * idleGlow);
				const dim = revealed ? 1 - lightAmt * 0.85 : 1;
				const breathe = forming ? 1 : 0.88 + 0.12 * Math.sin(t * 1.3);
				ctx.save();
				ctx.globalCompositeOperation = 'screen';
				ctx.globalAlpha = (0.25 + 0.65 * idleGlow) * dim * breathe;
				ctx.drawImage(SPR.white!, CX - cr, CY - cr, cr * 2, cr * 2);
				ctx.globalAlpha = 0.8 * idleGlow * dim * breathe;
				ctx.drawImage(SPR.lav!, CX - cr * 1.15, CY - cr * 1.15, cr * 2.3, cr * 2.3);
				ctx.restore();
			}

			drawLights(tr, lightAmt, true);

			const items: { x: number; y: number; depth: number; fade: number; s: Shard }[] = [];
			for (const s of ball) {
				const spin = rotU(s.u, rot);
				let x: number, y: number, depth: number, fade: number;
				if (forming) {
					const k = easeOutCubic(clamp01((t - s.st) / 0.75));
					const dSlot = shellR * s.jr;
					const dStart = r0() * s.sdm;
					if (k < 1) {
						const sv = rotU(s.sd, rot);
						x = CX + sv[0] * dStart + (spin[0] * dSlot - sv[0] * dStart) * k;
						y = CY + sv[1] * dStart * 0.96 + (spin[1] * dSlot * 0.96 - sv[1] * dStart * 0.96) * k;
						depth = sv[2] * k + spin[2] * (1 - k);
					} else {
						x = CX + spin[0] * dSlot;
						y = CY + spin[1] * dSlot * 0.96;
						depth = spin[2];
					}
					fade = 0.3 + 0.7 * k;
				} else {
					const dist = shellR * s.jr;
					x = CX + spin[0] * dist;
					y = CY + spin[1] * dist * 0.96;
					depth = spin[2];
					fade = revealed
						? Math.max(0.35, 1 - Math.max(0, tr - T_EXPAND * 0.72) / 1.6)
						: 1;
				}
				items.push({ x, y, depth, fade, s });
			}
			items.sort((a, b) => a.depth - b.depth);
			for (const it of items) {
				const s = it.s;
				const persp = 0.62 + 0.38 * it.depth;
				const base = 0.5 + 0.5 * it.depth;
				const spinT = t * (revealed ? 0.22 : 0.3);
				drawShardTri(it.x, it.y, s.sz * persp, s.rot + spinT * s.rv, s.col, base * it.fade, s);
			}

			// 揭球后段：待机缓浮小三角
			if (revealed && tr > T_EXPAND * 0.5 && Math.random() < 0.2) {
				ambient.push({
					x: R(0, W), y: H + 10, v: R(10, 26), sz: R(2, 5), a: R(0.08, 0.25),
					col: pick(SHARD_COLS), rot: R(0, TAU), rv: R(-0.8, 0.8),
				});
			}
			for (let i = ambient.length - 1; i >= 0; i--) {
				const p = ambient[i];
				p.y -= p.v * dt;
				p.rot += p.rv * dt;
				if (p.y < -20) { ambient.splice(i, 1); continue; }
				ctx.save();
				ctx.translate(p.x, p.y);
				ctx.rotate(p.rot);
				ctx.globalAlpha = p.a * Math.min(1, (H - p.y) / 120);
				ctx.fillStyle = p.col;
				ctx.beginPath();
				ctx.moveTo(0, -p.sz * 1.5); ctx.lineTo(p.sz * 1.3, p.sz); ctx.lineTo(-p.sz * 1.3, p.sz);
				ctx.closePath(); ctx.fill();
				ctx.restore();
			}

			drawLights(tr, lightAmt, false);
			ctx.restore();

			if (!titleShown && t >= T_FORM) { titleShown = true; root.classList.add('show'); }
			if (!tapShown && t >= T_FORM + 0.35) { tapShown = true; root.classList.add('ready'); }
			if (!revealed && t >= AUTO_REVEAL) reveal(t);
			raf = requestAnimationFrame(frame);
		}
		raf = requestAnimationFrame(frame);
	}

	document.addEventListener('astro:page-load', runIntro);

	function cleanupStaleIntro() {
		const el = document.getElementById('intro');
		if (!el) return;
		const isHome = window.location.pathname.replace(/\/+$/, '') === '';
		if (!isHome || w.__introDone) {
			el.remove();
		}
	}
	// 视图过渡换页时，Astro 可能携带旧页 DOM；离开主页或已播过时立刻清掉残留的动画层
	document.addEventListener('astro:before-swap', () => {
		cleanupStaleIntro();
	});
	window.addEventListener('astro:after-swap', cleanupStaleIntro);
	runIntro();
</script>
