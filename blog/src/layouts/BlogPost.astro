---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Comments from '../components/Comments.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime?: number;
	/** 上一篇（更早），由 [...slug].astro 算好传入 */
	older?: { href: string; title: string; no: string } | null;
	/** 下一篇（更新） */
	newer?: { href: string; title: string; no: string } | null;
};

const { title, description, pubDate, updatedDate, heroImage, heroImageAlt = '', readingTime, older, newer } = Astro.props;
// 评论区路径键：去掉尾斜杠的规范化路径，如 /blog/my-post
const commentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
// 分享卡：文章 hero 源图最大 1.5MB PNG，直接当 og:image 太重，先转成 1200 宽的小 jpg。
// 没配 heroImage 的文章落到 BaseHead 的站点默认卡。
const ogImageUrl = heroImage
	? (await getImage({ src: heroImage, format: 'jpg', width: 1200, quality: 82 })).src
	: undefined;
---

<html lang="zh-CN">
	<head>
		{/* 标题接站点名后缀，与站内其他页面同形（`关于 - Lapismind SEKAI`） */}
		<BaseHead title={`${title} - ${SITE_TITLE}`} description={description} imageUrl={ogImageUrl} />
		<style>
			/* 文章抬头左对齐，和下面的正文栏同一条左边线；底部一道墨色线收住 */
			.article-head {
				max-width: 48em;
				margin: 0 0 2.4rem;
				padding: 1rem 0 1.8rem;
				border-bottom: var(--rule-ink);
			}
			.article-head .meta {
				font-family: var(--font-meta);
				font-size: 0.78rem;
				letter-spacing: 0.08em;
				color: var(--muted);
				margin: 0 0 1.1rem;
				display: flex;
				align-items: center;
				gap: 0.6rem;
				flex-wrap: wrap;
			}
			.article-head .meta .dot {
				width: 3px;
				height: 3px;
				border-radius: 50%;
				background: var(--line-strong);
			}
			.article-head .meta time {
				white-space: nowrap;
			}
			.article-head h1 {
				margin: 0 0 1rem;
				font-size: clamp(2rem, 1.3rem + 2.6vw, 3.2rem);
				line-height: 1.2;
				text-wrap: balance;
			}
			.article-head .desc {
				color: var(--ink-soft);
				font-size: 1.05rem;
				margin: 0;
				max-width: 36em;
			}
			.last-updated-on {
				display: block;
				width: 100%;
				margin-top: 0.4em;
				font-style: italic;
				color: var(--muted);
				font-size: 0.85rem;
			}
			.hero-image {
				margin: 0 0 3rem;
			}
			.hero-image :global(img) {
				display: block;
				width: 100%;
				border-radius: var(--r-media);
				object-fit: cover;
			}
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				margin-bottom: 1.6rem;
				font-family: var(--font-meta);
				font-size: 0.82rem;
				text-decoration: none;
				color: var(--muted);
				transition: color 0.2s ease, gap 0.25s ease;
			}
			.back-link:hover {
				color: var(--primary);
				gap: 0.7em;
			}

			/* 上一篇 / 下一篇：左右两格，中间一道发丝线，像刊物的对页 */
			.post-pager {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
				gap: 1.5rem;
				margin-top: 3.5rem;
				padding-top: 1.4rem;
				border-top: var(--rule);
			}
			.post-pager .pg {
				display: grid;
				gap: 0.3rem;
				text-decoration: none;
				color: inherit;
				min-width: 0;
			}
			.post-pager .no {
				font-family: var(--font-num);
				font-size: 0.8rem;
				color: var(--primary);
			}
			.post-pager .t {
				font-size: 0.95rem;
				line-height: 1.6;
				color: var(--ink-soft);
				transition: color var(--dur-fast) ease;
			}
			.post-pager .pg:hover .t {
				color: var(--primary);
			}
			.post-pager .pg-next {
				text-align: right;
				justify-items: end;
			}

			/* 正文 + 目录双栏 */
			.article-layout {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 230px;
				gap: 3rem;
				align-items: start;
			}
			.article-main {
				min-width: 0;
			}
			/* 目录：一条竖向发丝线做轨道，当前节在轨道上亮一段主色，不再是玻璃盒 */
			.toc {
				position: sticky;
				top: calc(64px + 2rem);
				padding: 0.2rem 0 0.2rem;
				max-height: calc(100vh - 120px);
				overflow-y: auto;
			}
			.toc-label {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-family: var(--font-meta);
				font-size: 0.7rem;
				font-weight: 600;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--muted);
				margin: 0 0 0.8rem;
			}
			.toc-nav {
				display: flex;
				flex-direction: column;
				border-left: var(--rule);
			}
			.toc-nav :global(a) {
				display: block;
				margin-left: -1px;
				padding: 0.35em 0 0.35em 1em;
				font-size: 0.85rem;
				line-height: 1.5;
				color: var(--muted);
				text-decoration: none;
				transition: color 0.2s ease, box-shadow 0.2s ease;
			}
			.toc-nav :global(a:hover) {
				color: var(--ink);
			}
			.toc-nav :global(a.lvl-3) {
				padding-left: 1.9em;
				font-size: 0.8rem;
			}
			.toc-nav :global(a.active) {
				color: var(--ink);
				box-shadow: inset 2px 0 0 var(--primary);
			}
			.toc-empty {
				font-size: 0.85rem;
				color: var(--muted);
			}
			.toc-mobile-toggle {
				display: none;
				align-items: center;
				justify-content: center;
				gap: 0.3em;
				min-width: var(--tap-min);
				min-height: var(--tap-min);
				padding: 0 0.35rem;
				border: none;
				background: none;
				color: var(--muted);
				font-size: 0.75rem;
				font-family: var(--font-mono);
				letter-spacing: 0.1em;
				cursor: var(--cursor-pointer);
				transition: color 0.2s ease;
			}
			.toc-mobile-toggle:hover {
				color: var(--primary);
			}

			@media (max-width: 1080px) {
				.article-layout {
					grid-template-columns: minmax(0, 1fr);
					gap: 1.2rem;
				}
				.toc {
					position: static;
					order: -1;
					max-height: none;
					padding: 0.2rem 0;
					border-top: var(--rule);
					border-bottom: var(--rule);
				}
				.toc-nav {
					display: none;
				}
				.toc-nav.open {
					display: flex;
					padding-top: 0.4rem;
				}
				.toc-nav :global(a) {
					display: flex;
					align-items: center;
					min-height: var(--tap-min);
				}
				.toc-mobile-toggle {
					display: inline-flex;
				}
				.toc-label {
					margin: 0;
				}
			}
		</style>
	</head>

	<body>
		<div class="reading-progress" aria-hidden="true"></div>
		<Header />
		<main class="container page-main" id="main-content" tabindex="-1">
			<a class="back-link" href="/blog/">← 返回博客</a>
			<article>
				<header class="article-head">
					<div class="meta">
						<time><FormattedDate date={pubDate} /></time>
						{readingTime && (
							<>
								<span class="dot" aria-hidden="true"></span>
								<span>约 {readingTime} 分钟</span>
							</>
						)}
						{
							updatedDate && (
								<span class="last-updated-on">
									最后更新于 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					<h1>{title}</h1>
					<p class="desc">{description}</p>
				</header>

				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt={heroImageAlt} />
					</div>
				)}

				<div class="article-layout">
					<div class="article-main">
						<div class="prose">
							<slot />
						</div>
					</div>
					<aside class="toc" aria-label="文章目录">
						<p class="toc-label">
							<span>Contents</span>
							<button class="toc-mobile-toggle" type="button" aria-expanded="false">
								目录 <span aria-hidden="true">▾</span>
							</button>
						</p>
						<nav class="toc-nav" id="toc-nav"></nav>
					</aside>
				</div>

				<!-- 上一篇 / 下一篇：期号与博客索引同一套 -->
				{
					(older || newer) && (
						<nav class="post-pager" aria-label="文章翻页">
							{older ? (
								<a class="pg pg-prev" href={older.href}>
									<span class="no">{older.no}</span>
									<span class="t"><span aria-hidden="true">← </span>{older.title}</span>
								</a>
							) : (
								<span />
							)}
							{newer ? (
								<a class="pg pg-next" href={newer.href}>
									<span class="no">{newer.no}</span>
									<span class="t">{newer.title}<span aria-hidden="true"> →</span></span>
								</a>
							) : (
								<span />
							)}
						</nav>
					)
				}

				<!-- 评论区：GitHub 登录后可发，游客可读 -->
				<Comments pagePath={commentPath} />
			</article>
		</main>
		<Footer />

		<script>
			function initToc() {
				const prose = document.querySelector('.prose');
				const nav = document.getElementById('toc-nav');
				const wrap = (nav && nav.closest('.toc')) as HTMLElement | null;
				if (!prose || !nav || !wrap) return;

				const headings = [...prose.querySelectorAll('h2, h3')];
				const toggle = wrap.querySelector('.toc-mobile-toggle') as HTMLButtonElement | null;
				if (headings.length < 2) {
					wrap.style.display = 'none';
					return;
				}

				// 目录项
				headings.forEach((h: Element) => {
					const a = document.createElement('a');
					a.href = '#';
					a.textContent = h.textContent || '';
					a.classList.add(h.tagName === 'H3' ? 'lvl-3' : 'lvl-2');
					a.addEventListener('click', (e) => {
						e.preventDefault();
						scrollToHeading(h);
						if (nav.classList.contains('open')) {
							nav.classList.remove('open');
							toggle?.setAttribute('aria-expanded', 'false');
							toggle?.focus();
						}
					});
					nav.appendChild(a);
				});

				// 移动端展开/收起
				if (toggle) {
					toggle.addEventListener('click', () => {
						const open = nav.classList.toggle('open');
						toggle.setAttribute('aria-expanded', String(open));
					});
				}

				function scrollToHeading(h: Element) {
					const y = h.getBoundingClientRect().top + window.scrollY - 84;
					window.scrollTo({ top: y, behavior: 'smooth' });
				}

				// 滚动高亮
				const links = [...nav.querySelectorAll('a')];
				let ticking = false;
				const highlight = () => {
					if (ticking) return;
					ticking = true;
					requestAnimationFrame(() => {
						const mark = 96;
						let current = null;
						for (let i = 0; i < headings.length; i++) {
							if (headings[i].getBoundingClientRect().top - mark <= 0) current = i;
						}
						links.forEach((l, i) => l.classList.toggle('active', i === current));
						ticking = false;
					});
				};
				window.addEventListener('scroll', highlight, { passive: true });
				highlight();
			}

			document.addEventListener('astro:page-load', initToc);
		</script>
	</body>
</html>
