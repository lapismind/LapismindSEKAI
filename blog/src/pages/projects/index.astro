---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TurtleSoupCover from '../../assets/covers/turtle-soup-cover.png';
import ShowhandCover from '../../assets/covers/showhand-cover.png';
import AbracadawhatCover from '../../assets/covers/abracadawhat-cover.png';
import { SITE_TITLE } from '../../consts';
import { games } from '../../data/projects';

const projectImages: Record<string, typeof TurtleSoupCover> = {
	'turtle-soup': TurtleSoupCover,
	showhand: ShowhandCover,
	abracadawhat: AbracadawhatCover,
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`游戏作品 - ${SITE_TITLE}`} description="Lapismind 的个人游戏作品" />
		<style>
			.page-head {
				margin-bottom: 3rem;
			}
			.page-head p.lead {
				color: var(--muted);
				font-size: 1.08rem;
				max-width: 42em;
				margin: 0;
			}
			.project-list {
				display: flex;
				flex-direction: column;
				gap: 3.5rem;
			}
			.project-item {
				display: block;
				text-decoration: none;
				color: inherit;
			}
			/* 封面按各自原比例铺满整行，不设固定比例——2:1 的标题卡被裁掉两侧会破框 */
			.item-media {
				position: relative;
				overflow: hidden;
				border-radius: var(--radius-lg);
				border: 1px solid var(--line);
				background: var(--primary-ghost);
				box-shadow: var(--shadow-sm);
				transition: box-shadow var(--dur-base) var(--ease-soft),
					border-color var(--dur-base) var(--ease-soft);
			}
			.item-media :global(img) {
				width: 100%;
				height: auto;
				display: block;
				transition: transform var(--dur-slow) var(--ease-soft);
			}
			.project-item:hover .item-media {
				border-color: var(--primary-soft);
				box-shadow: var(--shadow-md), 0 0 0 1px var(--primary-soft);
			}
			.project-item:hover .item-media :global(img) {
				transform: scale(1.015);
			}
			.item-media-fallback {
				display: grid;
				place-items: center;
				aspect-ratio: 16 / 9;
				background: var(--gradient);
				color: var(--on-accent, #fff);
				font-size: 4rem;
				font-weight: 700;
			}
			.item-body {
				padding-top: 1.4rem;
			}
			.item-head {
				display: flex;
				align-items: baseline;
				gap: 0.7rem;
				flex-wrap: wrap;
			}
			.item-head h2 {
				margin: 0;
				font-size: 1.55rem;
			}
			.item-subtitle {
				margin: 0.4rem 0 0;
				font-size: 0.88rem;
				color: var(--primary);
				font-family: var(--font-mono);
			}
			.item-desc {
				margin: 0.85rem 0 0;
				max-width: 64ch;
				font-size: 0.96rem;
				color: var(--ink-soft);
				line-height: 1.8;
			}
			.item-foot {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.9rem 1.5rem;
				flex-wrap: wrap;
				margin-top: 1.2rem;
			}
			.item-go {
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--primary);
				white-space: nowrap;
				transition: transform var(--dur-fast) var(--ease-soft);
			}
			.project-item:hover .item-go {
				transform: translateX(3px);
			}
			.tech {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}
			.more-note {
				margin-top: 2.5rem;
				padding: 1.1rem 1.4rem;
				border-radius: var(--radius);
				border: 1px dashed var(--line-strong);
				color: var(--muted);
				font-size: 0.9rem;
			}
			.more-note a {
				font-weight: 600;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="container page-main" id="main-content" tabindex="-1">
			<header class="page-head reveal">
				<p class="eyebrow">stage select · games</p>
				<h1>游戏作品</h1>
				<p class="lead">
					这是我作为独立开发者的个人作品——每个游戏都是一次"把点子做成能玩的东西"的冒险。
				</p>
			</header>
			<div class="project-list">
				{
					games.map((p, i) => (
						<a class="project-item reveal" style={`--reveal-delay:calc(var(--stagger) * ${i})`} href={`/projects/${p.slug}/`}>
							<div class="item-media">
								{projectImages[p.slug] ? (
									<Image
										class="img-fade"
										src={projectImages[p.slug]}
										alt={`${p.name} 封面`}
										widths={[480, 760, 1100, 1600]}
										sizes="(max-width: 1180px) 92vw, 1100px"
									/>
								) : (
									<div class="item-media-fallback">{p.name.slice(0, 1)}</div>
								)}
							</div>
							<div class="item-body">
								<div class="item-head">
									<h2>{p.name}</h2>
									<span class={`status-badge status-${p.status}`}>
										{p.status === 'online' ? 'online' : '开发中'}
									</span>
								</div>
								<p class="item-subtitle">{p.subtitle}</p>
								<p class="item-desc">{p.description}</p>
								<div class="item-foot">
									<div class="tech">
										{p.tech.map((t) => <span class="tag">{t}</span>)}
									</div>
									<span class="item-go">查看详情 →</span>
								</div>
							</div>
						</a>
					))
				}
			</div>
			<p class="more-note reveal">
				更多游戏正在开发中，敬请期待。
			</p>
		</main>
		<Footer />
	</body>
</html>
