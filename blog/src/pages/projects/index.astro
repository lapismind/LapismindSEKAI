---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TurtleSoupCover from '../../assets/covers/turtle-soup-cover.png';
import ShowhandCover from '../../assets/covers/showhand-cover.png';
import AbracadawhatCover from '../../assets/covers/abracadawhat-cover.png';
import NiigoPartyCover from '../../assets/covers/niigo-party-cover.jpg';
import { SITE_TITLE } from '../../consts';
import { games } from '../../data/projects';

const projectImages: Record<string, typeof TurtleSoupCover> = {
	'turtle-soup': TurtleSoupCover,
	showhand: ShowhandCover,
	abracadawhat: AbracadawhatCover,
	'niigo-party': NiigoPartyCover,
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`游戏作品 - ${SITE_TITLE}`} description="Lapismind 的个人游戏作品" />
		<style>
			.game-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 5rem;
			}
			.game {
				display: block;
				text-decoration: none;
				color: inherit;
			}
			/* 条目抬头：编号 / 名称 / 状态 …… 进入，一行排开，像目录页的一个条目 */
			.game-head {
				display: grid;
				grid-template-columns: 3rem minmax(0, 1fr) auto;
				align-items: baseline;
				gap: 1rem;
				margin-bottom: 1.2rem;
			}
			.game-head .no {
				font-family: var(--font-num);
				font-size: 0.9rem;
				color: var(--primary);
			}
			.game-head h2 {
				margin: 0;
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.4rem 1rem;
				font-size: clamp(1.6rem, 1.2rem + 1.3vw, 2.3rem);
				transition: color var(--dur-fast) ease;
			}
			.game:hover .game-head h2 {
				color: var(--primary);
			}
			.go {
				display: inline-flex;
				align-items: center;
				gap: 0.45em;
				padding-bottom: 2px;
				border-bottom: 1px solid currentColor;
				font-size: 0.9rem;
				white-space: nowrap;
				color: var(--ink);
				transition: gap var(--dur-fast) var(--ease-soft), color var(--dur-fast) ease;
			}
			.game:hover .go {
				gap: 0.8em;
				color: var(--primary);
			}
			/* 封面按各自原比例铺满整行，不设固定比例——2:1 的标题卡被裁掉两侧会破框 */
			.game-media {
				overflow: hidden;
				border-radius: var(--r-media);
				background: var(--primary-ghost);
			}
			.game-media :global(img) {
				width: 100%;
				height: auto;
				display: block;
				transition: transform var(--dur-slow) var(--ease-soft);
			}
			.game:hover .game-media :global(img) {
				transform: scale(1.015);
			}
			.media-fallback {
				display: grid;
				place-items: center;
				aspect-ratio: 16 / 9;
				font-size: 4rem;
				font-weight: 700;
				color: var(--primary);
			}
			.game-info {
				display: grid;
				grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
				gap: 1.2rem 3rem;
				margin-top: 1.5rem;
				padding-left: 4rem;
			}
			.game-info .sub {
				margin: 0 0 0.6rem;
				color: var(--primary);
				font-size: 0.98rem;
			}
			.game-info .desc {
				margin: 0;
				color: var(--ink-soft);
				font-size: 0.95rem;
				line-height: 1.85;
			}
			.facts {
				margin: 0;
				display: grid;
				align-content: start;
			}
			.facts > div {
				display: grid;
				grid-template-columns: 3.2rem minmax(0, 1fr);
				gap: 0.8rem;
				padding: 0.6rem 0;
				border-top: var(--rule);
			}
			.facts > div:last-child {
				border-bottom: var(--rule);
			}
			.facts dt {
				font-family: var(--font-meta);
				font-size: 0.74rem;
				letter-spacing: 0.08em;
				color: var(--muted);
				line-height: 1.9;
			}
			.facts dd {
				margin: 0;
				font-size: 0.86rem;
				line-height: 1.7;
			}
			.facts .url {
				font-family: var(--font-meta);
				font-size: 0.8rem;
				color: var(--ink-soft);
			}
			.tech {
				display: flex;
				flex-wrap: wrap;
				gap: 0.1rem 0.55rem;
			}
			.more-note {
				margin: 4.5rem 0 0;
				padding-top: 1rem;
				border-top: var(--rule);
				color: var(--muted);
				font-size: 0.9rem;
			}

			@media (max-width: 760px) {
				.game-head {
					grid-template-columns: 2.2rem minmax(0, 1fr);
				}
				.game-head .go {
					display: none;
				}
				.game-info {
					grid-template-columns: minmax(0, 1fr);
					padding-left: 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="container page-main" id="main-content" tabindex="-1">
			<header class="page-title reveal">
				<h1>游戏作品</h1>
				<p class="lead">
					这是我作为独立开发者的个人作品——每个游戏都是一次"把点子做成能玩的东西"的冒险。
				</p>
				<p class="count"><b>{games.length}</b>stage select</p>
			</header>
			<ol class="game-list">
				{
					games.map((p, i) => (
						<li class="reveal">
							<a class="game" href={`/projects/${p.slug}/`}>
								<div class="game-head">
									<span class="no">{String(i + 1).padStart(2, '0')}</span>
									<h2>
										{p.name}
										<span class={`status-badge status-${p.status}`}>
											{p.status === 'online' ? 'online' : '开发中'}
										</span>
									</h2>
									<span class="go">查看详情 <span aria-hidden="true">→</span></span>
								</div>
								<div class="game-media">
									{projectImages[p.slug] ? (
										<Image
											class="img-fade"
											src={projectImages[p.slug]}
											alt={`${p.name} 封面`}
											widths={[480, 760, 1100, 1600]}
											sizes="(max-width: 1180px) 92vw, 1100px"
										/>
									) : (
										<div class="media-fallback">{p.name.slice(0, 1)}</div>
									)}
								</div>
								<div class="game-info">
									<div>
										<p class="sub">{p.subtitle}</p>
										<p class="desc">{p.description}</p>
									</div>
									<dl class="facts">
										{p.links.online && (
											<div>
												<dt>在线</dt>
												<dd class="url">{p.links.online.replace('https://', '')}</dd>
											</div>
										)}
										<div>
											<dt>技术</dt>
											<dd class="tech">{p.tech.map((t) => <span class="tag">{t}</span>)}</dd>
										</div>
									</dl>
								</div>
							</a>
						</li>
					))
				}
			</ol>
			<p class="more-note reveal">更多游戏正在开发中，敬请期待。</p>
		</main>
		<Footer />
	</body>
</html>
