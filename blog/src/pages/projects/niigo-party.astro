---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import NiigoPartyLineup from '../../assets/covers/niigo-party-cover.jpg';
import { SITE_TITLE } from '../../consts';
import { games } from '../../data/projects';

const project = games.find((p) => p.slug === 'niigo-party')!;
const { name, subtitle, description, tech, status } = project;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${name} - ${SITE_TITLE}`} description={subtitle} />
		<style>
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				margin-bottom: 2.2rem;
				font-family: var(--font-mono);
				font-size: 0.88rem;
				text-decoration: none;
				color: var(--muted);
				transition: color 0.2s ease, gap 0.25s ease;
			}
			.back-link:hover {
				color: var(--primary);
				gap: 0.7em;
			}
			.page-head {
				margin-bottom: 2.2rem;
			}
			.page-head .subtitle {
				color: var(--muted);
				font-size: 1.15rem;
				margin: 0.2em 0 1em;
			}
			.hero-img {
				width: 100%;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-md);
				margin-bottom: 2.2rem;
			}
			.hero-img :global(img) {
				width: 100%;
				height: auto;
				display: block;
			}
			.shot {
				margin: 1.9rem 0 0;
			}
			.shot :global(img) {
				width: 100%;
				height: auto;
				display: block;
				border-radius: var(--radius);
				border: 1px solid var(--line);
				box-shadow: var(--shadow-sm);
			}
			.shot figcaption {
				margin-top: 0.7rem;
				font-size: 0.85rem;
				color: var(--muted);
				text-align: center;
			}
			h2 {
				margin-top: 2.2em;
				padding-bottom: 0.45em;
				border-bottom: 1px solid var(--line);
				display: flex;
				align-items: center;
				gap: 0.6em;
				font-size: 1.4rem;
			}
			h2::before {
				content: '';
				width: 0.8em;
				height: 0.8em;
				border-radius: 3px;
				background: var(--gradient);
				flex-shrink: 0;
			}
			.tech-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="container-narrow page-main" id="main-content" tabindex="-1">
			<a class="back-link" href="/projects/">← 返回作品集</a>
			<header class="page-head reveal">
				<p class="eyebrow">game · {status}</p>
				<h1>{name}</h1>
				<p class="subtitle">{subtitle}</p>
				<span class={`status-badge status-${status}`}>{status === 'online' ? 'online' : '开发中'}</span>
			</header>

			<div class="hero-img reveal">
				<Image src={NiigoPartyLineup} alt={`${name} 立绘阵容`} />
			</div>

			<section class="reveal">
				<h2>项目简介</h2>
				<p>{description}</p>
			</section>

			<section class="reveal">
				<h2>技术栈</h2>
				<div class="tech-list">
					{tech.map((t) => (
						<span class="tag">{t}</span>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
