---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [first, ...rest] = posts;
/** 期号：按发布先后从 1 编起，最新一篇号最大——像刊物的期数，不随列表位置变 */
const issue = (i: number) => `No.${String(posts.length - i).padStart(2, '0')}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`博客 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			/* 头条：图文跨栏，不装进盒子 */
			.lead-story {
				display: grid;
				grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
				gap: 2.8rem;
				align-items: center;
				text-decoration: none;
				color: inherit;
				margin-bottom: 5rem;
			}
			.lead-media {
				aspect-ratio: 16 / 10;
				overflow: hidden;
				border-radius: var(--r-media);
				background: var(--primary-ghost);
			}
			.lead-media :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform var(--dur-slow) var(--ease-soft);
			}
			.lead-story:hover .lead-media :global(img) {
				transform: scale(1.03);
			}
			.meta {
				display: flex;
				align-items: baseline;
				gap: 0.9rem;
				margin: 0 0 1rem;
				font-family: var(--font-meta);
				font-size: 0.76rem;
				letter-spacing: 0.08em;
				color: var(--muted);
			}
			.meta .no {
				font-family: var(--font-num);
				font-size: 0.85rem;
				color: var(--primary);
				letter-spacing: 0.02em;
			}
			.lead-story h2 {
				margin: 0 0 0.9rem;
				font-size: clamp(1.7rem, 1.2rem + 1.4vw, 2.4rem);
				line-height: 1.25;
				transition: color var(--dur-fast) ease;
			}
			.lead-story:hover h2 {
				color: var(--primary);
			}
			.lead-story .desc {
				margin: 0;
				color: var(--ink-soft);
				font-size: 0.98rem;
				line-height: 1.85;
			}
			.go {
				display: inline-flex;
				align-items: center;
				gap: 0.45em;
				margin-top: 1.5rem;
				padding-bottom: 2px;
				border-bottom: 1px solid currentColor;
				font-size: 0.9rem;
				color: var(--ink);
				transition: gap var(--dur-fast) var(--ease-soft), color var(--dur-fast) ease;
			}
			.lead-story:hover .go {
				gap: 0.8em;
				color: var(--primary);
			}

			/* 归档：一行一篇，期号 / 日期 / 标题与摘要 / 小图 */
			.archive {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.row {
				display: grid;
				grid-template-columns: 4.2rem 8.5rem minmax(0, 1fr) 176px;
				grid-template-areas: 'no date body thumb';
				gap: 0.3rem 1.4rem;
				align-items: start;
				padding: 1.6rem 0;
				border-bottom: var(--rule);
				text-decoration: none;
				color: inherit;
			}
			.archive > li:first-child .row {
				padding-top: 0.3rem;
			}
			.row .no {
				grid-area: no;
				font-family: var(--font-num);
				font-size: 0.85rem;
				color: var(--primary);
				line-height: 1.9;
			}
			.row .date {
				grid-area: date;
				margin: 0;
				font-family: var(--font-meta);
				font-size: 0.78rem;
				color: var(--muted);
				line-height: 2.1;
				white-space: nowrap;
			}
			.row .body {
				grid-area: body;
				min-width: 0;
			}
			.row h3 {
				margin: 0 0 0.4rem;
				font-size: 1.18rem;
				line-height: 1.5;
				transition: color var(--dur-fast) ease;
			}
			.row:hover h3 {
				color: var(--primary);
			}
			.row .desc {
				margin: 0;
				font-size: 0.9rem;
				line-height: 1.75;
				color: var(--muted);
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.row .thumb {
				grid-area: thumb;
				aspect-ratio: 16 / 10;
				overflow: hidden;
				border-radius: 4px;
				background: var(--primary-ghost);
			}
			.row .thumb :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform var(--dur-slow) var(--ease-soft);
			}
			.row:hover .thumb :global(img) {
				transform: scale(1.04);
			}

			@media (max-width: 860px) {
				.lead-story {
					grid-template-columns: minmax(0, 1fr);
					gap: 1.4rem;
					margin-bottom: 4rem;
				}
				.row {
					grid-template-columns: minmax(0, 1fr) 112px;
					grid-template-areas:
						'meta thumb'
						'body thumb';
					gap: 0.4rem 1rem;
				}
				.row > .no,
				.row > .date {
					display: none;
				}
				.row .m-meta {
					display: flex;
				}
			}
			.m-meta {
				display: none;
				grid-area: meta;
				margin: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="container page-main" id="main-content" tabindex="-1">
			<header class="page-title reveal">
				<h1>博客</h1>
				<p class="lead">开发记录、踩坑笔记，和把想法变成作品的过程。</p>
				<p class="count"><b>{posts.length}</b>篇文章</p>
			</header>

			{
				first && (
					<a class="lead-story reveal" href={`/blog/${first.id}/`}>
						<div class="lead-media">
							{/* 头条大图不挂 img-fade：它是本页最靠上的大图，
							    等淡入会把首屏观感往后推（其余卡片图照常淡入） */}
							{first.data.heroImage && <Image width={760} height={475} src={first.data.heroImage} alt={first.data.heroImageAlt ?? ''} />}
						</div>
						<div>
							<p class="meta">
								<span class="no">{issue(0)}</span>
								<span>最新</span>
								<FormattedDate date={first.data.pubDate} />
							</p>
							<h2>{first.data.title}</h2>
							<p class="desc">{first.data.description}</p>
							<span class="go">阅读全文 <span aria-hidden="true">→</span></span>
						</div>
					</a>
				)
			}

			<header class="sec-head reveal">
				<h2>往期</h2>
				<span class="sec-en">archive</span>
			</header>
			<ol class="archive">
				{
					rest.map((post, i) => (
						<li class="reveal" style={`--reveal-delay:calc(var(--stagger) * ${Math.min(i, 4)})`}>
							<a class="row" href={`/blog/${post.id}/`}>
								<span class="no">{issue(i + 1)}</span>
								<p class="date"><FormattedDate date={post.data.pubDate} /></p>
								<p class="meta m-meta">
									<span class="no">{issue(i + 1)}</span>
									<FormattedDate date={post.data.pubDate} />
								</p>
								<div class="body">
									<h3>{post.data.title}</h3>
									<p class="desc">{post.data.description}</p>
								</div>
								<div class="thumb">
									{post.data.heroImage && <Image class="img-fade" width={352} height={220} src={post.data.heroImage} alt={post.data.heroImageAlt ?? post.data.title} />}
								</div>
							</a>
						</li>
					))
				}
			</ol>
		</main>
		<Footer />
	</body>
</html>
