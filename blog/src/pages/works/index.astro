---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE, GITHUB_URL } from '../../consts';
import { works } from '../../data/projects';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`Projects - ${SITE_TITLE}`} description="Lapismind 的软件作品：工具、mod 与开源仓库" />
		<style>
			.work-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			/* 一条作品一行：编号 / 正文 / 属性栏，行与行之间只有一道发丝线 */
			.work {
				display: grid;
				grid-template-columns: 3rem minmax(0, 1fr) 15rem;
				gap: 1rem 2.5rem;
				padding: 2.2rem 0;
				border-bottom: var(--rule);
			}
			.work-list > li:first-child .work {
				padding-top: 0.4rem;
			}
			.work .no {
				font-family: var(--font-num);
				font-size: 0.9rem;
				color: var(--primary);
				line-height: 2.6;
			}
			.work h2 {
				margin: 0 0 0.5rem;
				font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
			}
			.work h2 :global(a) {
				color: inherit;
				text-decoration: none;
				transition: color var(--dur-fast) ease;
			}
			.work h2 :global(a:hover) {
				color: var(--primary);
			}
			.work .sub {
				margin: 0 0 0.9rem;
				color: var(--primary);
				font-size: 0.95rem;
			}
			.work .desc {
				margin: 0;
				max-width: 62ch;
				color: var(--ink-soft);
				font-size: 0.95rem;
				line-height: 1.85;
			}
			.go {
				display: inline-flex;
				align-items: center;
				gap: 0.45em;
				margin-top: 1.3rem;
				padding-bottom: 2px;
				border-bottom: 1px solid currentColor;
				font-size: 0.9rem;
				color: var(--ink);
				text-decoration: none;
				transition: gap var(--dur-fast) var(--ease-soft), color var(--dur-fast) ease;
			}
			.go:hover {
				gap: 0.8em;
				color: var(--primary);
			}
			.facts {
				margin: 0.5rem 0 0;
				display: grid;
				align-content: start;
			}
			.facts > div {
				display: grid;
				grid-template-columns: 3.2rem minmax(0, 1fr);
				gap: 0.8rem;
				padding: 0.6rem 0;
				border-top: var(--rule);
			}
			.facts > div:last-child {
				border-bottom: var(--rule);
			}
			.facts dt {
				font-family: var(--font-meta);
				font-size: 0.74rem;
				letter-spacing: 0.08em;
				color: var(--muted);
				line-height: 1.9;
			}
			.facts dd {
				margin: 0;
				font-size: 0.86rem;
				line-height: 1.7;
			}
			.facts .ver {
				font-family: var(--font-meta);
				font-size: 0.8rem;
				color: var(--ink);
			}
			.facts .links {
				display: flex;
				gap: 1rem;
			}
			.facts .links :global(a) {
				font-weight: 600;
			}
			.tech {
				display: flex;
				flex-wrap: wrap;
				gap: 0.1rem 0.55rem;
			}
			.more-note {
				margin: 3rem 0 0;
				color: var(--muted);
				font-size: 0.9rem;
			}
			.more-note a {
				font-weight: 600;
			}

			@media (max-width: 760px) {
				.work {
					grid-template-columns: 2.2rem minmax(0, 1fr);
				}
				.facts {
					grid-column: 2;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="container page-main" id="main-content" tabindex="-1">
			<header class="page-title reveal">
				<h1>Projects</h1>
				<p class="lead">
					游戏之外的作品：工具、mod 与开源仓库，之后或许会发布到 GitHub。
				</p>
				<p class="count"><b>{works.length}</b>workbench</p>
			</header>
			<ol class="work-list">
				{
					works.map((p, i) => (
						<li class="reveal" style={`--reveal-delay:calc(var(--stagger) * ${i})`}>
							<article class="work">
								<span class="no">{String(i + 1).padStart(2, '0')}</span>
								<div>
									<h2><a href={`/works/${p.slug}/`}>{p.name}</a></h2>
									<p class="sub">{p.subtitle}</p>
									<p class="desc">{p.description}</p>
									<a class="go" href={`/works/${p.slug}/`}>
										查看详情 <span aria-hidden="true">→</span>
									</a>
								</div>
								<dl class="facts">
									<div>
										<dt>版本</dt>
										<dd class="ver">{p.version ?? (p.status === 'online' ? 'online' : '开发中')}</dd>
									</div>
									<div>
										<dt>技术</dt>
										<dd class="tech">{p.tech.map((t) => <span class="tag">{t}</span>)}</dd>
									</div>
									{(p.links.github || p.links.download) && (
										<div>
											<dt>获取</dt>
											<dd class="links">
												{p.links.github && (
													<a href={p.links.github} target="_blank" rel="noopener">
														GitHub
													</a>
												)}
												{p.links.download && <a href={p.links.download}>下载</a>}
											</dd>
										</div>
									)}
								</dl>
							</article>
						</li>
					))
				}
			</ol>
			<p class="more-note reveal">
				更多项目整理中——GitHub 上还有：<a href={GITHUB_URL} target="_blank" rel="noopener">@lapismind</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
