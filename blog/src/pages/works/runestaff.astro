---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ShotStance from '../../assets/works/stance.jpg';
import ShotShield from '../../assets/works/shield.jpg';
import ShotAxe from '../../assets/works/axe.jpg';
import { SITE_TITLE } from '../../consts';
import { works } from '../../data/projects';

const project = works.find((p) => p.slug === 'runestaff')!;
const { name, subtitle, description, tech, links, version, status } = project;

const shots = [
	{ src: ShotStance, caption: '站立' },
	{ src: ShotShield, caption: '剑盾形态 · 防御中' },
	{ src: ShotAxe, caption: '斧形态 · 双月刃' },
];

// 详情都在开发记录里，这一页只留最简单的东西
const devlog = { href: '/blog/rune-staff/', title: '首谈法杖盾斧的开发历程' };
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${name} - ${SITE_TITLE}`} description={subtitle} />
		<style>
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				margin-bottom: 2.2rem;
				font-family: var(--font-mono);
				font-size: 0.88rem;
				text-decoration: none;
				color: var(--muted);
				transition: color 0.2s ease, gap 0.25s ease;
			}
			.back-link:hover {
				color: var(--primary);
				gap: 0.7em;
			}
			.page-head {
				margin-bottom: 1.8rem;
			}
			.page-head .subtitle {
				color: var(--muted);
				font-size: 1.1rem;
				margin: 0.2em 0 0.9em;
			}
			.links {
				display: flex;
				gap: 0.8rem;
				flex-wrap: wrap;
				margin-bottom: 2.4rem;
			}
			.shots {
				display: flex;
				gap: 1.2rem;
				align-items: stretch;
			}
			.shots .lead {
				flex: 0 0 54%;
			}
			.shots .rest {
				flex: 1 1 auto;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				gap: 1.2rem;
			}
			.shots figure {
				margin: 0;
				display: flex;
				flex-direction: column;
			}
			.shots :global(img) {
				width: 100%;
				height: auto;
				display: block;
				border-radius: var(--radius);
				border: 1px solid var(--line);
				box-shadow: var(--shadow-sm);
			}
			.shots figcaption {
				margin-top: 0.6rem;
				font-size: 0.82rem;
				color: var(--muted);
				text-align: center;
			}
			@media (max-width: 720px) {
				.shots {
					flex-direction: column;
				}
				.shots .lead,
				.shots .rest {
					flex: 0 0 auto;
				}
				.shots .rest {
					gap: 1.2rem;
				}
			}
			.summary {
				margin-top: 2.4rem;
				max-width: 62ch;
			}
			.summary p {
				margin: 0 0 1.1rem;
				line-height: 1.85;
			}
			.tech-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 2rem;
			}
			.devlog {
				display: flex;
				align-items: baseline;
				gap: 0.9rem;
				flex-wrap: wrap;
				padding: 1rem 1.3rem;
				border-radius: var(--radius);
				border: 1px solid var(--line);
				background: var(--card-solid);
				box-shadow: var(--shadow-sm);
				text-decoration: none;
				color: inherit;
				transition: border-color var(--dur-base) var(--ease-soft),
					box-shadow var(--dur-base) var(--ease-soft), transform var(--dur-base) var(--ease-soft);
			}
			.devlog:hover {
				border-color: var(--primary-soft);
				box-shadow: var(--shadow-md);
				transform: translateY(-2px);
			}
			.devlog .label {
				font-family: var(--font-mono);
				font-size: 0.82rem;
				color: var(--primary);
				letter-spacing: 0.04em;
			}
			.devlog .title {
				font-weight: 600;
			}
			.devlog .go {
				margin-left: auto;
				color: var(--primary);
				transition: transform var(--dur-fast) var(--ease-soft);
			}
			.devlog:hover .go {
				transform: translateX(3px);
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="container-narrow page-main" id="main-content" tabindex="-1">
			<a class="back-link" href="/works/">← 返回 Projects</a>

			<header class="page-head reveal">
				<p class="eyebrow">project · {status}</p>
				<h1>{name}</h1>
				<p class="subtitle">{subtitle}</p>
				<span class={`status-badge status-${status}`}>{version}</span>
			</header>

			<div class="links reveal">
				<a class="btn btn-primary" href={links.download} download>
					下载 {version} <span aria-hidden="true">↓</span>
				</a>
				{links.github && (
					<a class="btn btn-ghost" href={links.github} target="_blank" rel="noopener">
						GitHub 仓库
					</a>
				)}
			</div>

			<div class="shots reveal">
				<figure class="lead">
					<Image src={shots[0].src} alt={`${name} ${shots[0].caption}`} />
					<figcaption>{shots[0].caption}</figcaption>
				</figure>
				<div class="rest">
					{
						shots.slice(1).map((s) => (
							<figure>
								<Image src={s.src} alt={`${name} ${s.caption}`} />
								<figcaption>{s.caption}</figcaption>
							</figure>
						))
					}
				</div>
			</div>

			<div class="summary reveal">
				<p>{description}</p>
				<div class="tech-list">
					{tech.map((t) => <span class="tag">{t}</span>)}
				</div>
				<a class="devlog" href={devlog.href}>
					<span class="label">开发历程</span>
					<span class="title">{devlog.title}</span>
					<span class="go" aria-hidden="true">→</span>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
