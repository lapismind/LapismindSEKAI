---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import AiforumPreview from '../../assets/aiforum-preview.png';
import { SITE_TITLE } from '../../consts';
import { workProjects } from '../../data/projects';
const project = workProjects.find((p) => p.slug === 'aiforum')!;
const { name, subtitle, description, tech, links, status } = project;
const features = [
	'新手教程：从零教员工使用星辰超级智能体，理解 Skill 与 AI 概念',
	'实战任务：周报自动生成、文档归档、数据洞察，附项目结构与提示词写法',
	'进阶知识：API / 端点 / MCP / Agent / Token 等名词科普，智能体 vs 问答助手区别',
	'案例库：公诚业务与日常办公的 AI 落地案例',
	'高进阶演示：展示把 Skill 发展成本地可视化网页的操作系统',
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`AI 平台 - ${SITE_TITLE}`} description="Lapismind 的企业 AI 学习平台项目" />
		<style>
			.breadcrumb {
				display: flex;
				align-items: center;
				gap: 0.4em;
				margin-bottom: 2.2rem;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: var(--muted);
			}
			.breadcrumb a {
				text-decoration: none;
				transition: color 0.2s ease;
			}
			.breadcrumb a:hover {
				color: var(--primary);
			}
			.breadcrumb .sep {
				opacity: 0.6;
			}
			.page-head {
				margin-bottom: 2.2rem;
			}
			.page-head .subtitle {
				color: var(--muted);
				font-size: 1.15rem;
				margin: 0.2em 0 1em;
			}
			.hero-img {
				width: 100%;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-md);
				margin-bottom: 2.2rem;
			}
			.links {
				display: flex;
				gap: 0.8rem;
				flex-wrap: wrap;
				margin-bottom: 1.6rem;
			}
			h2 {
				margin-top: 2.2em;
				padding-bottom: 0.45em;
				border-bottom: 1px solid var(--line);
				display: flex;
				align-items: center;
				gap: 0.6em;
				font-size: 1.4rem;
			}
			h2::before {
				content: '';
				width: 0.8em;
				height: 0.8em;
				border-radius: 3px;
				background: var(--gradient);
				flex-shrink: 0;
			}
			.feature-list {
				padding-left: 1.3em;
			}
			.feature-list li {
				margin-bottom: 0.55em;
			}
			.feature-list li::marker {
				color: var(--primary);
			}
			.tech-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.note-box {
				margin-top: 3rem;
				padding: 1rem 1.3rem;
				border-radius: var(--radius);
				border: 1px dashed var(--line-strong);
				color: var(--muted);
				font-size: 0.9rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="container-narrow page-main">
			<nav class="breadcrumb" aria-label="面包屑">
				<a href="/">首页</a>
				<span class="sep">/</span>
				<span>AI 平台</span>
			</nav>
			<header class="page-head reveal">
				<p class="eyebrow">enterprise · ai</p>
				<h1>{name}</h1>
				<p class="subtitle">{subtitle}</p>
				<span class={`status-badge status-${status}`}>{status === 'online' ? 'online' : '开发中'}</span>
			</header>

			<div class="hero-img reveal">
				<Image src={AiforumPreview} alt={`${name} 页面截图`} />
			</div>

			<div class="links reveal">
				{links.online && (
					<a class="btn btn-primary" href={links.online} target="_blank" rel="noopener">
						访问平台 <span aria-hidden="true">→</span>
					</a>
				)}
			</div>

			<section class="reveal">
				<h2>项目简介</h2>
				<p>{description}</p>
			</section>

			<section class="reveal">
				<h2>平台内容</h2>
				<ul class="feature-list">
					{features.map((f) => (
						<li>{f}</li>
					))}
				</ul>
			</section>

			<section class="reveal">
				<h2>技术栈</h2>
				<div class="tech-list">
					{tech.map((t) => (
						<span class="tag">{t}</span>
					))}
				</div>
			</section>

			<section class="reveal">
				<h2>部署说明</h2>
				<p>
					纯静态站点（HTML + CSS + JavaScript），通过 Cloudflare Workers 托管在自定义域名
					aiforum.qmzhj.top，无需后端服务，云端 24h 常驻、低成本维护。内容以 Markdown 和
					结构化数据组织，便于持续更新。
				</p>
			</section>

			<p class="note-box">
				这是工作中的企业项目，与个人游戏作品分开管理。个人作品在
				<a href="/projects/">游戏作品</a> 栏目。
			</p>
		</main>
		<Footer />
	</body>
</html>
