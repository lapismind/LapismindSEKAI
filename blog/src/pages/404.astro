---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`404 - ${SITE_TITLE}`} description="页面不存在" />
		<style>
			/* 编辑式 404：一道墨色线起头，左边大号数字，右边说明与入口；
			   右缘一行竖排日文点题。不再用渐变大字。 */
			.notfound {
				display: grid;
				grid-template-columns: auto minmax(0, 1fr) auto;
				align-items: end;
				gap: 2rem 3rem;
				border-top: var(--rule-ink);
				margin-top: 2.5rem;
				padding: 3rem 0 4rem;
			}
			.code {
				margin: 0;
				font-family: var(--font-num);
				font-size: clamp(4rem, 2rem + 8vw, 8rem);
				font-weight: 700;
				line-height: 0.9;
				letter-spacing: -0.02em;
				color: var(--ink);
			}
			.text .tip {
				margin: 0 0 0.6rem;
				font-size: 1.35rem;
				font-weight: 700;
				color: var(--ink);
			}
			.text .sub {
				margin: 0 0 1.8rem;
				color: var(--ink-soft);
				max-width: 30em;
			}
			.actions {
				display: flex;
				gap: 0.8rem 1.4rem;
				flex-wrap: wrap;
				align-items: center;
			}
			.vert {
				margin: 0;
				align-self: start;
				writing-mode: vertical-rl;
				font-size: 1.05rem;
				letter-spacing: 0.42em;
				color: var(--muted);
				border-left: var(--rule);
				padding-left: 1.1rem;
				min-height: 15em;
			}
			@media (max-width: 640px) {
				.notfound {
					grid-template-columns: minmax(0, 1fr);
					align-items: start;
					gap: 1.4rem;
					padding: 2.2rem 0 3rem;
				}
				.vert {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="container page-main" id="main-content" tabindex="-1">
			<section class="notfound reveal">
				<p class="code" aria-hidden="true">404</p>
				<div class="text">
					<p class="tip">这条路还没铺好</p>
					<p class="sub">
						你访问的页面不存在，或者它被我挪走了。
						回首页看看作品和博客吧。
					</p>
					<div class="actions">
						<a class="btn btn-primary" href="/">回到首页 <span aria-hidden="true">→</span></a>
						<a class="btn btn-ghost" href="/blog/">看看博客</a>
					</div>
				</div>
				<p class="vert" aria-hidden="true">この道は、まだ。</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
