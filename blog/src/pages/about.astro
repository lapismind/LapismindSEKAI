						))
					}
				</div>
			</section>

			<section class="section-block reveal">
				<p class="eyebrow">oshi · 单推</p>
				{/* 方形视觉卡：姓名和罗马音已写进昼夜图；短句留给网页排版。
				   亮色＝白天（她抬头），暗色＝夜里（她低头）—— 切主题是换一个时辰。 */}
				<div class="oshi-card">
					<h3 class="sr-only">{oshiCard.unit} · {oshiCard.name} · {oshiCard.nameEn}</h3>
					<div class="oshi-photo">
						<Image
							class="oshi-shot-day"
							src={OshiDay}
							alt="朝比奈真冬坐在无鱼的水族箱中，靠着右侧玻璃望向水面上方"
							widths={[380, 560, 760, 1024]}
							sizes="(max-width: 800px) 100vw, 760px"
							loading="lazy"
							decoding="async"
						/>
						<Image
							class="oshi-shot-night"
							src={OshiNight}
							alt="夜色里，朝比奈真冬在同一只无鱼的水族箱中抱膝低头"
							widths={[380, 560, 760, 1024]}
							sizes="(max-width: 800px) 100vw, 760px"
							loading="lazy"
							decoding="async"
						/>

						{/* 水里的动静，全在水线以下：水面呼吸高光 + 一道缓慢横扫的光柱
						    + 三道错拍散光 + 五颗上浮气泡 + 三条互相交织、能跟着滚动晃的水线。
						    水、浪、造景都不在这里 —— 图里都有，这里只补"在动"。
						    内层 .oshi-water-inner 单独一层：滚动引起的水体横移只动它，
						    外层 .oshi-water 的裁剪不能跟着走（否则波光会溢出到水面之上）。 */}
						<div class="oshi-water" aria-hidden="true">
							<div class="oshi-water-inner">
								<span class="oshi-waterline"></span>
								{waves.map((w) => (
									<span class={`oshi-wave ${w.cls}`}>
										<svg viewBox="0 0 1000 40" preserveAspectRatio="none">
											<path d={w.d} />
										</svg>
									</span>
								))}
								<span class="oshi-ray"></span>
								<span class="caustic caustic-a"></span>
								<span class="caustic caustic-b"></span>
								<span class="caustic caustic-c"></span>
								<span class="bubble b1"></span>
								<span class="bubble b2"></span>
								<span class="bubble b3"></span>
								<span class="bubble b4"></span>
								<span class="bubble b5"></span>
							</div>
						</div>

					</div>

					{/* 同一块空水区：白天是公开答案，夜里浮出另一层意思。 */}
					<div class="oshi-body">
						<div class="oshi-facts">
							<div class="oshi-fact">
								<p class="k">趣味</p>
