							</div>
						</div>
					</div>
				</div>
				<noscript>
					<p class="oshi-nojs">{oshiInner.items.map((item) => `${item.k}：${item.v}`).join('　·　')}</p>
				</noscript>
			</section>

			<section class="section-block reveal">
				<p class="eyebrow">worlds · 这个站的世界</p>
				<div class="worlds">
					<a class="world-card glass" href="/projects/">
						<p class="w-eyebrow">game world</p>
						<h3>游戏作品</h3>
						<p>我作为独立开发者做的个人游戏——海龟汤、卡牌对战，以及未来更多。</p>
						<span class="go">进入 <span aria-hidden="true">→</span></span>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	/* 卡在视口里移动 → 水面波动。
	   两个关键决定：

	   ① 驱动量是**卡片自己的视口位置变化**，不是 window.scrollY。
	      对缸里的水来说，"谁让它动的"没有区别 —— 滚轮、拖滚动条、键盘翻页、锚点跳转、
	      惯性滚动、将来某个容器内部滚动，对卡片都只是同一件事：它在用户眼里移动了。
	      只认它自己的位置，就不必去枚举有多少种滚动来源（枚举必然漏）。
	      用 getBoundingClientRect().top 逐帧取差，一次读取，什么来源都覆盖。

	   ② 位移**不是**直接映射成波形（那读起来像滑块，一停就僵在最大位），而是把移动
	      当成给水面的一个冲量，之后让一个阻尼弹簧自己荡回去 —— 水被打一下会自己晃、
	      自己停，这才是"水"。所以移动只负责 v += Δ，位移 x 由每帧的
	      v += -k·x; v *= damping; x += v 解出来。

	   两条纪律：
	   · 卡不在视口里就不跑（否则整页滚动都在给一张看不见的卡算弹簧，白烧电）；
	   · reduced-motion 下整段不跑 —— 此时 --slosh 未定义，CSS 里 var(--slosh, 0) 兜到 0，
	     波形回到静止态，不留残影。 */
	/* 遍历所有卡片而不是只取第一张：一页完全可能有多张（预览页就是亮暗各一张），
	   写成 querySelector 的话第二张永远不会有水面波动。每张卡各自一套弹簧状态。
	   不写 TS 泛型：本段会被自包含预览页原样内联，泛型到浏览器就是语法错误、整段不跑。 */
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
	  for (const card of document.querySelectorAll('.oshi-card')) {
		// instanceof 把 Element 收窄成 HTMLElement：TS 认，JS 也合法。
		// 写成 `card as HTMLElement` 的话，预览页内联这段同样是语法错误。
		if (!(card instanceof HTMLElement)) continue;
			const K = 0.01; // 弹簧刚度 → 周期约 1.05s（水的节奏；0.022 时像果冻）
			const DAMPING = 0.978; // 每帧衰减 → 约 3s 荡平
			/* 增益是实测调出来的：0.0035 时一次普通滚动就把 --slosh 顶在 ±1 饱和，
			   看起来像卡住而不是水在晃；现在这一档快滚峰值约 0.6–0.8，还看得见回弹。 */
			const GAIN = 0.0002; // 每帧位移 → 冲量
			const IMPULSE_MAX = 0.1; // 单帧冲量上限（此时已经顶到最大波幅），防"甩一下飞出去"
			let x = 0;
			let v = 0;
			let raf = 0;
			let prevTop = 0;
			let last = 0;
			let lastWritten = NaN;

			/* tick 不接参数：requestAnimationFrame 会把时间戳传进来，但那需要写 `(now: number)`，
			   而本段会被自包含预览页原样内联 —— TS 标注到浏览器就是语法错误。用 performance.now()
			   取值，既没有参数也没有标注，两边都合法。 */
			const tick = () => {
				const now = performance.now();
				// 按真实帧间隔积分（以 60fps 的 16.667ms 为 1 个单位）。
				// 不这么做的话弹簧是按帧衰减的：120Hz 屏上同一段动画会快一倍 —— 效果随显示器变。
				// 冲量那边不必换算：一次滚动 D 像素的总冲量恒为 D×GAIN，与帧率无关。
				const dt = last ? Math.min(50, now - last) / 16.667 : 1;
				last = now;
				const top = card.getBoundingClientRect().top;
				const d = top - prevTop;
				prevTop = top;
				if (d) v += Math.max(-IMPULSE_MAX, Math.min(IMPULSE_MAX, d * GAIN));
				v += -K * x * dt;
				v *= Math.pow(DAMPING, dt);
				x += v * dt;
				if (Math.abs(x) < 0.002 && Math.abs(v) < 0.002) {
					x = 0;
					v = 0;
				}
				const s = Math.max(-1, Math.min(1, x));
				// 每帧都写 style 会白白触发样式计算；值没变就不写
				if (s !== lastWritten) {
					lastWritten = s;
					card.style.setProperty('--slosh', s.toFixed(4));
					card.style.setProperty('--slosh-abs', Math.abs(s).toFixed(4));
				}
				raf = requestAnimationFrame(tick);
			};

			const io = new IntersectionObserver(
				(entries) => {
					if (entries[0].isIntersecting) {
						if (!raf) {
							prevTop = card.getBoundingClientRect().top;
							last = 0;
							raf = requestAnimationFrame(tick);
						}
					} else if (raf) {
						cancelAnimationFrame(raf);
						raf = 0;
						x = 0;
						v = 0;
						lastWritten = 0;
						card.style.setProperty('--slosh', '0');
						card.style.setProperty('--slosh-abs', '0');
					}
				},
				{ rootMargin: '160px' },
			);
			io.observe(card);
	  }
	}

	/* 点击水面 → 从点的地方冒一串气泡，升到接近水面时淡掉。
	   三条纪律：
	   · **只认水面之下的点击**。水面上方是画进图里的姓名，在那里点一下不该冒泡。
	     绑 click 而不是 pointerdown —— 拖动选字 / 滚动起步都不会误触。
	   · 气泡在**接近水面时淡完**，不靠 .oshi-water 的 overflow 去切：硬切会看到半颗泡消失。
	     所以上浮距离取 0.9×（点击处到水面的距离），永远停在水面之下一点。
	   · 连点有上限（BURST_MAX 组同时在飞），否则一直点会堆出几百个节点。 */
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const BURST_MAX = 6;
		let flying = 0;
		for (const card of document.querySelectorAll('.oshi-card')) {
			if (!(card instanceof HTMLElement)) continue;
			const water = card.querySelector('.oshi-water-inner');
			if (!(water instanceof HTMLElement)) continue;
			card.addEventListener('click', (e) => {
				if (!(e instanceof MouseEvent)) return;
				if (flying >= BURST_MAX) return;
				const wr = water.getBoundingClientRect();
				const x = e.clientX - wr.left;
				const y = e.clientY - wr.top;
				// y < 0 就是水面之上：那里是画里的姓名，点一下不该冒泡
				if (y < 0 || y > wr.height || x < 0 || x > wr.width) return;
				flying++;
				// 用一次性标记回收，而不是把节点收进数组：数组会被 TS 推成 any[]（这段还要能
				// 原样内联进预览页，不能写类型标注），而标记法顺带保证多组气泡同时飞时不会互相删错
				const tag = 'burst-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
				const n = 7 + Math.floor(Math.random() * 5);
				let maxWait = 0;
				for (let i = 0; i < n; i++) {
					const b = document.createElement('span');
					b.className = 'oshi-pop';
					b.dataset.burst = tag;
					const size = 3 + Math.random() * 6;
					const dur = 1.5 + Math.random() * 1.6;
					const delay = Math.random() * 0.3;
					const rise = Math.min(y, Math.max(12, y * 0.9));
					maxWait = Math.max(maxWait, dur + delay);
					b.style.left = x + 'px';
					b.style.top = y + 'px';
					b.style.width = size + 'px';
					b.style.height = size + 'px';
					b.style.setProperty('--pop-dx', (Math.random() * 2 - 1) * 26 + 'px');
					b.style.setProperty('--pop-rise', -rise + 'px');
					b.style.setProperty('--pop-dur', dur + 's');
					b.style.setProperty('--pop-delay', delay + 's');
					water.appendChild(b);
				}
				window.setTimeout(() => {
					for (const b of water.querySelectorAll('[data-burst="' + tag + '"]')) b.remove();
					flying--;
				}, (maxWait + 0.4) * 1000);
			});
		}
	}
</script>
