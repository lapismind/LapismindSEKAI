---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={'个人资料 - ' + SITE_TITLE} description="查看你的玩家身份、头像与游戏战绩绑定信息。" />
		<style>
			.profile-shell { max-width: 640px; margin: 0 auto; }
			.profile-card { display: grid; grid-template-columns: auto 1fr; gap: 1.8rem; align-items: center; padding: 2rem 2.2rem; position: relative; overflow: hidden; }
			.avatar-wrap { position: relative; }
			.avatar-wrap img { width: 116px; height: 116px; border-radius: 28px; object-fit: cover; border: 3px solid var(--card-solid); box-shadow: 0 0 0 1px var(--line-strong), var(--shadow-md); background: var(--primary-ghost); }
			.identity-tag { display: inline-flex; align-items: center; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; padding: 0.25em 0.9em; border-radius: 999px; background: var(--gradient); color: #fff; box-shadow: var(--shadow-sm); }
			.identity-tag.guest { background: var(--card-solid); color: var(--muted); border: 1px solid var(--line-strong); box-shadow: none; }
			.identity h1 { margin: 0.5rem 0 0.3rem; font-size: 1.7rem; line-height: 1.25; }
			.identity .sub { margin: 0 0 0.4rem; color: var(--ink-soft); font-size: 0.92rem; }
			.name-row { display: flex; align-items: baseline; gap: 0.5rem; }
			.name-pencil { display: grid; place-items: center; width: 26px; height: 26px; border: 1px solid var(--line); border-radius: 8px; background: var(--card-solid); color: var(--muted); font-size: 0.8rem; line-height: 1; cursor: var(--cursor-pointer); opacity: 0; transition: opacity 0.15s ease, color 0.15s ease, border-color 0.15s ease; }
			.name-row:hover .name-pencil, .name-pencil:focus-visible { opacity: 1; }
			.name-pencil:hover { color: var(--primary); border-color: var(--primary); }
			.name-editor { padding: 0.15em 0.4em; border: 1px solid var(--primary); border-radius: 8px; background: var(--card-solid); color: var(--ink); font: inherit; font-size: 1.7rem; font-weight: 700; line-height: 1.25; }
			.name-msg { margin: 0.3rem 0 0; font-size: 0.82rem; color: #d64545; }
			.meta-list { display: flex; flex-direction: column; padding: 0.5rem 1.4rem; margin-top: 1.2rem; }
			.meta-row { display: grid; grid-template-columns: 8em 1fr; gap: 1rem; align-items: baseline; padding: 0.75em 0; border-bottom: 1px dashed var(--line); }
			.meta-row:last-child { border-bottom: none; }
			.meta-row .label { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.14em; color: var(--primary); }
			.meta-row .text { margin: 0; font-size: 0.92rem; color: var(--ink-soft); word-break: break-all; }
			.actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.4rem; }
			.btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0.62em 1.35em; border-radius: 999px; border: 1px solid transparent; font-size: 0.92rem; font-weight: 600; text-decoration: none; cursor: var(--cursor-pointer); transition: transform 0.2s ease, filter 0.2s ease, border-color 0.2s ease; }
			.btn:hover { transform: translateY(-2px); }
			.btn-primary { background: var(--gradient); color: #fff; }
			.btn-primary:hover { filter: brightness(1.08); color: #fff; }
			.btn-ghost { border-color: var(--line-strong); color: var(--ink-soft); background: var(--card-solid); }
			.btn-ghost:hover { border-color: var(--primary); color: var(--primary); }
			.hint { margin-top: 1.6rem; padding: 1rem 1.3rem; border-radius: var(--radius-lg); border: 1px dashed var(--line); font-size: 0.85rem; color: var(--muted); line-height: 1.8; }
			.error-box { padding: 1.4rem 1.6rem; text-align: center; color: var(--muted); }
			.skeleton { padding: 3rem; text-align: center; color: var(--muted); font-family: var(--font-mono); font-size: 0.85rem; }
			.avatar-wrap { position: relative; }
			.avatar-btn { position: relative; display: inline-block; padding: 0; border: 0; background: transparent; border-radius: 28px; cursor: var(--cursor-pointer); line-height: 0; }
			.avatar-btn img { width: 116px; height: 116px; border-radius: 28px; object-fit: cover; border: 3px solid var(--card-solid); box-shadow: 0 0 0 1px var(--line-strong), var(--shadow-md); background: var(--primary-ghost); transition: transform 0.18s ease, box-shadow 0.18s ease; }
			.avatar-btn:hover img { transform: scale(1.02); box-shadow: 0 0 0 2px var(--primary), var(--shadow-md); }
			.avatar-btn:focus-visible img { box-shadow: 0 0 0 2px var(--primary), var(--shadow-md); }
			.avatar-modal { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; padding: 1.2rem; z-index: 60; }
			.avatar-modal[hidden] { display: none; }
			.avatar-modal-backdrop { position: absolute; inset: 0; background: rgba(10, 12, 24, 0.55); backdrop-filter: blur(2px); }
			.avatar-modal-card { position: relative; width: min(440px, 100%); max-height: 86vh; overflow: auto; padding: 1.4rem 1.5rem 1.6rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
			.avatar-modal-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
			.avatar-modal-head h2 { margin: 0; font-size: 1.15rem; }
			.avatar-modal-close { border: 1px solid var(--line-strong); background: var(--card-solid); color: var(--ink-soft); width: 34px; height: 34px; border-radius: 50%; font-size: 1.2rem; line-height: 1; cursor: var(--cursor-pointer); }
			.avatar-modal-close:hover { border-color: var(--primary); color: var(--primary); }
			.picker-note { margin: 0.4rem 0 1rem; font-size: 0.82rem; color: var(--muted); }
			.avatar-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(58px, 1fr)); gap: 0.7rem; }
			.avatar-cell { position: relative; aspect-ratio: 1 / 1; padding: 0; border: 2px solid var(--line); border-radius: 16px; background: var(--card-solid); overflow: hidden; cursor: var(--cursor-pointer); transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease; }
			.avatar-cell:hover { border-color: var(--primary); transform: translateY(-2px); }
			.avatar-cell.is-active { border-color: transparent; background: linear-gradient(var(--card-solid), var(--card-solid)) padding-box, var(--gradient) border-box; box-shadow: var(--shadow-sm); }
			.avatar-cell img { width: 100%; height: 100%; object-fit: cover; display: block; }
			.avatar-cell .check { position: absolute; right: 4px; bottom: 4px; width: 18px; height: 18px; border-radius: 50%; background: var(--gradient); color: #fff; font-size: 11px; line-height: 18px; text-align: center; box-shadow: var(--shadow-sm); }
			@media (max-width: 640px) { .profile-card { grid-template-columns: 1fr; text-align: center; justify-items: center; padding: 1.6rem; } .actions { justify-content: center; } .meta-row { grid-template-columns: 1fr; gap: 0.2rem; text-align: left; } }
		</style>

		<!-- 成就展馆：卡片全部由 JS 动态创建，样式须 is:global 才生效（项目已知教训） -->
		<style is:global>
			.ach-shell, .career-shell { margin-top: 1.2rem; padding: 1.4rem 1.6rem 1.6rem; }
			.ach-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
			.ach-head h2 { margin: 0; font-size: 1.15rem; }
			.ach-head .ach-summary { margin: 0; font-size: 0.85rem; color: var(--muted); font-family: var(--font-mono); }
			.ach-section-card { margin-top: 0.8rem; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--card-bg); }
			.ach-section-toggle { display: flex; align-items: center; justify-content: space-between; gap: 1rem; width: 100%; min-height: 48px; padding: 0.85rem 1.1rem; border: 0; background: transparent; color: inherit; cursor: var(--cursor-pointer); text-align: left; }
			.ach-section-toggle:hover { background: var(--primary-ghost); }
			.ach-section-toggle:focus-visible { outline: 3px solid var(--primary); outline-offset: -3px; }
			.ach-section-info { display: flex; flex-direction: column; gap: 0.16rem; min-width: 0; }
			.ach-section-title { font-size: 1rem; font-weight: 650; color: var(--ink); }
			.ach-section-note, .ach-section-count { font-size: 0.76rem; color: var(--muted); }
			.ach-section-count { font-family: var(--font-mono); white-space: nowrap; }
			.ach-caret { color: var(--primary); font-size: 0.85rem; flex: none; transition: transform 0.15s ease; }
			.ach-section-body { display: flex; flex-direction: column; padding: 0.2rem 0.6rem 0.7rem; }
			.ach-row { display: flex; align-items: center; gap: 1rem; padding: 0.7rem 0.5rem; border-top: 1px dashed var(--line); }
			.ach-row:first-child { border-top: none; }
			.ach-row.locked { opacity: 0.62; filter: saturate(0.35); }
			.ach-row-text { min-width: 0; flex: 1; }
			.ach-name { margin: 0 0 0.15rem; font-size: 0.95rem; font-weight: 650; color: var(--ink); }
			.ach-desc { margin: 0; font-size: 0.76rem; line-height: 1.5; color: var(--muted); }
			.ach-row-right { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 0.2rem; }
			.ach-difficulty { font-size: 0.72rem; letter-spacing: 0.04em; color: oklch(0.62 0.13 75); white-space: nowrap; }
			.ach-mark { font-size: 1rem; color: var(--muted); }
			.ach-row.earned .ach-mark { color: oklch(0.6 0.14 150); }
			.ach-empty { padding: 1.4rem; text-align: center; color: var(--muted); font-size: 0.88rem; border: 1px dashed var(--line); border-radius: var(--radius); }
			.ach-state { padding: 1.2rem; text-align: center; color: var(--muted); font-size: 0.86rem; border: 1px dashed var(--line); border-radius: var(--radius); }
			.ach-state p { margin: 0 0 0.8rem; }
			.ach-state[hidden], #ach-content[hidden] { display: none; }
			.career-head { margin-bottom: 1rem; }
			.career-head h2 { margin: 0; font-size: 1.15rem; }
			.career-head p { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.82rem; }
			.career-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; margin: 0; }
			.career-row { min-width: 0; padding: 0.75rem 0.85rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card-bg); }
			.career-row.wide { grid-column: 1 / -1; }
			.career-row dt { margin: 0 0 0.2rem; color: var(--primary); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.05em; }
			.career-row dd { margin: 0; color: var(--ink); font-size: 0.92rem; line-height: 1.5; overflow-wrap: anywhere; }
			@media (max-width: 480px) { .ach-shell, .career-shell { padding: 1.15rem 1rem 1.25rem; } .career-grid { grid-template-columns: 1fr; } .career-row.wide { grid-column: auto; } .ach-row { align-items: flex-start; gap: 0.7rem; } }
		</style>
	</head>
	<body>
		<Header />
		<main class="container-narrow page-main" id="main-content" tabindex="-1">
			<header class="page-head reveal">
				<p class="eyebrow">player profile</p>
				<h1>个人资料</h1>
			</header>

			<div class="profile-shell">
				<div id="profile-loading" class="skeleton glass">正在读取身份……</div>
				<div id="profile-error" class="error-box glass" hidden>
					<p>身份服务暂时不可用，请稍后再试。</p>
					<button type="button" class="btn btn-ghost" id="pf-retry">重试</button>
				</div>
				<div id="profile-content" hidden>
					<section class="profile-card glass">
						<div class="avatar-wrap">
							<button id="pf-avatar-btn" class="avatar-btn" type="button" aria-label="点击更换头像">
								<img id="pf-avatar" src="" alt="玩家头像" width="116" height="116" />
							</button>
						</div>
						<div class="identity">
							<span id="pf-tag" class="identity-tag"></span>
														<div class="name-row">
								<h1 id="pf-name"></h1>
								<button id="pf-name-edit" class="name-pencil" type="button" aria-label="修改昵称">✎</button>
							</div>
							<p id="pf-name-msg" class="name-msg" hidden></p>
							<p id="pf-sub" class="sub"></p>
						</div>
					</section>

					<section class="meta-list glass">
						<div class="meta-row">
							<span class="label">PLAYER ID</span>
							<p class="text" id="pf-player-id"></p>
						</div>
						<div class="meta-row" id="pf-github-row">
							<span class="label">GITHUB</span>
							<p class="text" id="pf-github"></p>
						</div>
					</section>

					<div id="avatar-modal" class="avatar-modal glass" hidden>
						<div class="avatar-modal-backdrop" data-close="1"></div>
						<div class="avatar-modal-card glass" role="dialog" aria-modal="true" aria-label="选择头像">
							<div class="avatar-modal-head">
								<h2>选择头像</h2>
								<button class="avatar-modal-close" type="button" data-close="1" aria-label="关闭">×</button>
							</div>
							<p class="picker-note" id="pf-avatar-note" hidden></p>
							<div id="avatar-grid" class="avatar-grid" role="listbox" aria-label="可选头像"></div>
						</div>
					</div>

					<section id="ach-section" class="ach-shell glass" aria-labelledby="ach-title">
						<div class="ach-head">
							<h2 id="ach-title">成就展馆</h2>
							<p id="ach-summary" class="ach-summary">正在清点奖杯……</p>
						</div>
						<div id="ach-loading" class="ach-state" role="status">正在读取成就与法师档案……</div>
						<div id="ach-error" class="ach-state" role="alert" hidden>
							<p>成就与法师档案暂时无法读取。</p>
							<button type="button" class="btn btn-ghost" id="ach-retry">重试</button>
						</div>
						<div id="ach-empty" class="ach-state" hidden>还没有可展示的成就，法师档案会从完整比赛开始记录。</div>
						<div id="ach-content" hidden>
							<div id="ach-hall"></div>
						</div>
					</section>

					<section id="career-section" class="career-shell glass" hidden aria-labelledby="career-title">
						<div class="career-head">
							<h2 id="career-title">法师档案</h2>
							<p>仅展示认证服务汇总的完整比赛记录。</p>
						</div>
						<dl id="career-grid" class="career-grid"></dl>
					</section>

					<div class="actions">
						<a id="pf-github-link" class="btn btn-ghost" href="#" target="_blank" rel="noopener" hidden>GitHub 主页 ↗</a>
						<a id="pf-register-entry" class="btn btn-primary" href="/login" hidden>进入 SEKAI</a>
						<button id="pf-logout" type="button" class="btn btn-ghost" hidden>退出登录</button>
					</div>

					<p class="hint">
						游客也可以玩所有游戏，当前这局的故事会正常显示；最近战报需要持久登录后才能跨设备查看。登录不会向本站暴露你的邮箱。
					</p>

				</div>
			</div>
		</main>
		<Footer />

		<script>
			import { createAuthClient } from '@lapismind/lobby-kit';
			import guestAvatar from '@lapismind/lobby-kit/avatars/0.png';
			import { avatarChoices, avatarUrlById } from '../lib/avatarChoices.js';
			import { buildAchievementSections, buildCareerRows } from '../lib/profilePresentation.js';

			const guestAvatarSrc = typeof guestAvatar === 'string' ? guestAvatar : guestAvatar.src;
			const auth = createAuthClient();

			const el = (id: string) => document.getElementById(id) as HTMLElement;
			const loading = el('profile-loading');
			const errorBox = el('profile-error');
			const content = el('profile-content');

			function setText(node: HTMLElement, value: unknown) { node.textContent = value == null ? '' : String(value); }

			
			async function loadProfile() {
				loading.hidden = false;
				errorBox.hidden = true;
				content.hidden = true;
				try {
					const user = await auth.init();
					if (!user) throw new Error('no user');
					render(user);
					loading.hidden = true;
					content.hidden = false;
					void loadAchievements();
				} catch {
					loading.hidden = true;
					errorBox.hidden = false;
				}
			}

			// ---------- 成就展馆与法师档案（只展示 API 数据） ----------
			let currentAchievementsController: AbortController | null = null;
			let requestGeneration = 0;

			async function loadAchievements() {
				currentAchievementsController?.abort();
				const generation = ++requestGeneration;
				const loadingState = el('ach-loading');
				const errorState = el('ach-error');
				const emptyState = el('ach-empty');
				const achievementsContent = el('ach-content');
				const controller = new AbortController();
				currentAchievementsController = controller;
				const timeout = window.setTimeout(() => controller.abort(), 2000);
				loadingState.hidden = false;
				errorState.hidden = true;
				emptyState.hidden = true;
				achievementsContent.hidden = true;
				el('career-section').hidden = true;
				try {
					const res = await auth.getAchievements({ signal: controller.signal });
					if (generation !== requestGeneration) return;
					if (!res.ok) throw new Error('no achievements data');
					renderHall(res);
					renderCareer(res.career);
					const hasAchievements = Array.isArray(res.achievements) && res.achievements.length > 0;
					emptyState.hidden = hasAchievements;
					achievementsContent.hidden = !hasAchievements;
				} catch {
					if (generation !== requestGeneration) return;
					errorState.hidden = false;
					el('career-section').hidden = true;
				} finally {
					window.clearTimeout(timeout);
					if (generation !== requestGeneration) return;
					currentAchievementsController = null;
					loadingState.hidden = true;
				}
			}

			function teardownAchievements() {
				requestGeneration += 1;
				currentAchievementsController?.abort();
				currentAchievementsController = null;
			}
			document.addEventListener('astro:before-swap', teardownAchievements, { once: true });
			window.addEventListener('pagehide', teardownAchievements, { once: true });

			function renderHall(payload: any) {
				const hall = el('ach-hall');
				hall.textContent = '';
				const sections = buildAchievementSections(payload.achievements || []);
				if (!sections.length || !sections.some((section: any) => section.items.length)) {
					const p = document.createElement('p');
					p.className = 'ach-empty';
					p.textContent = '成就目录还是空的，等成就系统上线后，这里会摆满奖杯。';
					hall.appendChild(p);
					setText(el('ach-summary'), '成就即将上线');
					return;
				}

				let first = true;
				for (const section of sections) {
					const card = document.createElement('section');
					card.className = 'ach-section-card';
					card.dataset.achievementSection = section.key;
					const panelId = 'ach-panel-' + section.key;

					const head = document.createElement('button');
					head.type = 'button';
					head.className = 'ach-section-toggle';
					head.setAttribute('aria-expanded', String(first));
					head.setAttribute('aria-controls', panelId);
					const info = document.createElement('div');
					info.className = 'ach-section-info';
					const title = document.createElement('span');
					title.className = 'ach-section-title';
					title.setAttribute('role', 'heading');
					title.setAttribute('aria-level', '3');
					title.textContent = section.title;
					const note = document.createElement('span');
					note.className = 'ach-section-note';
					note.textContent = section.gameName + ' · ' + section.description;
					info.append(title, note);
					const count = document.createElement('span');
					count.className = 'ach-section-count';
					count.textContent = section.unlockedCount + ' / ' + section.items.length + ' 已解锁';
					const caret = document.createElement('span');
					caret.className = 'ach-caret';
					caret.setAttribute('aria-hidden', 'true');
					caret.textContent = first ? '▾' : '▸';
					head.append(info, count, caret);

					const body = document.createElement('ul');
					body.className = 'ach-section-body';
					body.id = panelId;
					body.hidden = !first;
					for (const achievement of section.items) body.appendChild(renderAchRow(achievement));

					head.addEventListener('click', () => {
						const open = body.hidden;
						body.hidden = !open;
						head.setAttribute('aria-expanded', String(open));
						caret.textContent = open ? '▾' : '▸';
					});

					card.append(head, body);
					hall.appendChild(card);
					first = false;
				}

				const legacy = Number(payload.legacyUnlockedCount) || 0;
				setText(el('ach-summary'), '传奇 ' + (Number(payload.unlockedCount) || 0) + ' / ' + (Number(payload.total) || 0) + (legacy ? ' · 旧日纪念 ' + legacy : ''));
			}

			function renderAchRow(a: any) {
				const row = document.createElement('li');
				row.className = 'ach-row ' + (a.unlocked ? 'earned' : 'locked');
				row.dataset.achievementKey = a.key;

				const txt = document.createElement('div');
				txt.className = 'ach-row-text';
				const name = document.createElement('p');
				name.className = 'ach-name';
				name.textContent = a.name;
				const desc = document.createElement('p');
				desc.className = 'ach-desc';
				desc.textContent = a.desc;
				txt.append(name, desc);

				const right = document.createElement('div');
				right.className = 'ach-row-right';
				if (a.difficultyLabel) {
					const difficulty = document.createElement('span');
					difficulty.className = 'ach-difficulty';
					difficulty.textContent = a.difficultyLabel;
					right.appendChild(difficulty);
				}
				const mark = document.createElement('span');
				mark.className = 'ach-mark';
				mark.textContent = a.unlocked ? '✓' : '锁定';
				right.appendChild(mark);

				row.append(txt, right);
				if (a.unlocked && a.unlockedAt) row.title = '解锁于 ' + String(a.unlockedAt).slice(0, 10);
				return row;
			}

			function renderCareer(career: any) {
				const section = el('career-section');
				const grid = el('career-grid');
				grid.textContent = '';
				if (!career) {
					section.hidden = true;
					return;
				}
				for (const row of buildCareerRows(career)) {
					const item = document.createElement('div');
					item.className = 'career-row' + (row.label === '八系魔法成功次数' ? ' wide' : '');
					const label = document.createElement('dt');
					label.textContent = row.label;
					const value = document.createElement('dd');
					value.textContent = row.value;
					item.append(label, value);
					grid.appendChild(item);
				}
				section.hidden = false;
			}

			let wired = false;

			// ---------- 头像选择（点击头像弹出弹窗） ----------
			let pickerWired = false;
			const avatarGrid = el('avatar-grid');
			const avatarModal = el('avatar-modal');
			function openAvatarModal() {
				buildAvatarGrid();
				highlightAvatar(auth.getUser()?.avatarId);
				avatarModal.hidden = false;
			}
			function closeAvatarModal() { avatarModal.hidden = true; }
			el('pf-avatar-btn').addEventListener('click', openAvatarModal);
			avatarModal.querySelectorAll('[data-close]').forEach((c) => c.addEventListener('click', closeAvatarModal));
			document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !avatarModal.hidden) closeAvatarModal(); });
			function buildAvatarGrid() {
				if (pickerWired) return;
				avatarGrid.textContent = '';
				for (const a of avatarChoices) {
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'avatar-cell';
					btn.dataset.id = a.id;
					btn.setAttribute('role', 'option');
					btn.setAttribute('aria-label', '头像 ' + a.id);
					const img = document.createElement('img');
					img.src = a.url;
					img.alt = '头像 ' + a.id;
					btn.appendChild(img);
					const chk = document.createElement('span');
					chk.className = 'check';
					chk.textContent = '✓';
					chk.hidden = true;
					chk.dataset.role = 'check';
					btn.appendChild(chk);
					btn.addEventListener('click', () => selectAvatar(a.id ?? ''));
					avatarGrid.appendChild(btn);
				}
				pickerWired = true;
			}
			function highlightAvatar(id: string | number | null | undefined) {
				for (const cell of Array.from(avatarGrid.children) as HTMLElement[]) {
					const active = cell.dataset.id === String(id);
					cell.classList.toggle('is-active', active);
					const chk = cell.querySelector('[data-role="check"]') as HTMLElement | null;
					if (chk) chk.hidden = !active;
				}
			}
			async function selectAvatar(id: string) {
				const note = el('pf-avatar-note');
				const res = await auth.setAvatar(id);
				if (!res.ok) { note.hidden = false; note.textContent = '切换失败，请稍后重试。'; return; }
				const current = auth.getUser();
				const localAvatar = avatarUrlById(current?.avatarId);
				(el('pf-avatar') as HTMLImageElement).src = localAvatar
					? localAvatar
					: (current?.avatarUrl || guestAvatarSrc);
				highlightAvatar(current?.avatarId);
				note.hidden = true;
				closeAvatarModal();
			}

			function render(user: any) {
				const isGithub = user.provider === 'github';
				const isAccount = user.provider === 'account';
				const localAvatar = avatarUrlById(user.avatarId);
				(el('pf-avatar') as HTMLImageElement).src = localAvatar
					? localAvatar
					: (isGithub && user.avatarUrl ? user.avatarUrl : guestAvatarSrc);
				const tag = el('pf-tag');
				setText(tag, isGithub ? 'GITHUB 用户' : isAccount ? '账号用户' : '游客 · 未登录');
				tag.classList.toggle('guest', !user || user.provider === 'guest');
				setText(el('pf-name'), user.displayName || user.nickname || (isGithub ? 'GitHub 用户' : isAccount ? '账号用户' : '游客'));
				setText(el('pf-sub'), isGithub ? '已通过 GitHub 登录，身份跨设备同步' : isAccount ? '用户名密码登录，跨设备同步' : '本地游客身份，可玩所有游戏');
				setText(el('pf-player-id'), user.playerId || '-');
				setText(el('pf-github'), isGithub ? '@' + (user.nickname || user.githubId || '-') : isAccount ? '未使用（用户名密码方式）' : '未绑定（以游客身份游玩）');
				
				if (isGithub && user.githubId) {
					(el('pf-github-link') as HTMLAnchorElement).href = 'https://github.com/' + encodeURIComponent(String(user.nickname || user.githubId));
					el('pf-github-link').hidden = false;
					el('pf-logout').hidden = false;
					el('pf-register-entry').hidden = true;
				} else if (isAccount) {
					el('pf-github-link').hidden = true;
					el('pf-logout').hidden = false;
					el('pf-register-entry').hidden = true;
				} else {
					el('pf-register-entry').hidden = false;
				}
				// 头像选择：构建一次网格，高亮当前选择
				buildAvatarGrid();
				highlightAvatar(user.avatarId);
				el('pf-avatar-note').hidden = true;
				if (!wired) {
					wired = true;
					el('pf-logout').addEventListener('click', async () => {
						await auth.logout();
						location.reload();
					});
					el('pf-name-edit').addEventListener('click', startEditName);
					el('pf-name').addEventListener('click', startEditName);
				}
			}

			// 点击昵称或铅笔图标进入编辑：Enter/失焦保存，Esc 取消（改昵称属于基础操作，不写提示文案）
			function startEditName() {
				const nameEl = el('pf-name')
				const current = nameEl.textContent || ''
				el('pf-name-msg').hidden = true
				const input = document.createElement('input')
				input.type = 'text'
				input.className = 'name-editor'
				input.maxLength = 24
				input.value = current
				nameEl.replaceWith(input)
				el('pf-name-edit').hidden = true
				input.focus()
				input.select()
				let settled = false
				const finish = async (save: boolean) => {
					if (settled) return
					settled = true
					let next = current
					if (save) {
						const raw = input.value.trim()
						const res = await auth.setNickname(raw)
						if (res.ok) {
							const u = auth.getUser()
							next = (u?.displayName || u?.nickname || raw) as string
						} else {
							const msg = el('pf-name-msg')
							msg.textContent = '保存失败，请重试'
							msg.hidden = false
						}
					}
					input.replaceWith(nameEl)
					setText(nameEl, next)
					el('pf-name-edit').hidden = false
				}
				input.addEventListener('keydown', (e: KeyboardEvent) => {
					if (e.key === 'Enter') { e.preventDefault(); finish(true) }
					else if (e.key === 'Escape') finish(false)
				})
				input.addEventListener('blur', () => finish(true))
			}

			loadProfile();
			el('pf-retry').addEventListener('click', loadProfile);
			el('ach-retry').addEventListener('click', loadAchievements);

		</script>
	</body>
</html>
