---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Live2dMascot from '../components/Live2dMascot.astro';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Mascot from '../assets/mascot.webp';
import HeroBg from '../assets/mafuyu-hero.webp';
import MinchoSubset from '../assets/fonts/shippori-mincho-subset.woff2';
import AbracadawhatCover from '../assets/covers/abracadawhat-cover.png';
import StaffCard from '../assets/works/staff-card.jpg';
import NiigoPartyLineup from '../assets/covers/niigo-party-cover.jpg';
import songs from '../data/music-player.json';
import { games, works } from '../data/projects';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = allPosts.slice(0, 3);
/** 「SEKAI is running」面板的"最近更新"：取最新一篇，有内容产出本身就是站点在运转的证据。 */
const latestPost = allPosts[0];

const onlineCount = games.filter((p) => p.status === 'online').length;

/** 首页「SEKAI 精选」：游戏与项目各取 featured 条目，详情页分属 /projects/ 与 /works/。 */
const featured = [
	...games.filter((p) => p.featured).map((p) => ({ ...p, kind: '游戏', href: `/projects/${p.slug}/` })),
	...works.filter((p) => p.featured).map((p) => ({ ...p, kind: 'Projects', href: `/works/${p.slug}/` })),
];
const pad2 = (n: number) => String(n).padStart(2, '0');

const projectImages: Record<string, typeof AbracadawhatCover> = {
	abracadawhat: AbracadawhatCover,
	runestaff: StaffCard,
};

---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		{/* Astro 的 <style> 不做插值，@font-face 要内联输出才拿得到资源地址。
		    日文明朝体：只给首屏的日文行用。子集只有这两句话的假名/汉字（7KB），
		    缺的字自动回落到霞鹜文楷。 */}
		<style is:inline set:html={`@font-face{font-family:'Shippori Mincho Subset';font-style:normal;font-weight:500;font-display:swap;src:url('${MinchoSubset}') format('woff2')}`} />
		<style>
			/* ============ Hero ============
			   整幅卡面出血到视口边；文字落在左下，不再居中压在奏的脸上。
			   底部一条发丝线托住玩家身份 / 今日箱曲 / 向下提示，三件事并成一行。
			   打字机脚本认 .hero h1 与 .hero .lead，别改这两个选择器。 */
			.hero {
				position: relative;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				min-height: min(92vh, 920px);
				width: 100vw;
				margin-left: calc(50% - 50vw);
				margin-right: calc(50% - 50vw);
				margin-top: -64px;
				overflow: hidden;
				color: #fff;
				background: oklch(0.2 0.03 265);
			}
			.hero-photo {
				position: absolute;
				inset: 0;
				animation: hero-fade 1.1s var(--ease-soft) 0.1s both;
			}
			.hero-photo img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 22%;
				display: block;
			}
			@keyframes hero-fade {
				from {
					opacity: 0;
					transform: scale(1.03);
				}
				to {
					opacity: 1;
					transform: none;
				}
			}
			/* 两层压暗：左侧给标题让出可读区，底部给信息行让出可读区；
			   中上部（两人的脸）保持原画亮度。 */
			.hero-photo::after {
				content: '';
				position: absolute;
				inset: 0;
				background:
					linear-gradient(
						90deg,
						oklch(0.14 0.035 268 / 0.78) 0%,
						oklch(0.14 0.035 268 / 0.42) 38%,
						oklch(0.14 0.035 268 / 0) 70%
					),
					linear-gradient(
						180deg,
						oklch(0.14 0.035 268 / 0.4) 0%,
						oklch(0.14 0.035 268 / 0) 22%,
						oklch(0.14 0.035 268 / 0) 50%,
						oklch(0.14 0.035 268 / 0.82) 100%
					);
			}
			.hero-inner {
				position: relative;
				z-index: 1;
				width: min(1100px, 100% - 2.5rem);
				margin-inline: auto;
				padding-top: calc(64px + 5rem);
			}
			.hero-copy {
				max-width: 40rem;
				padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
			}
			.hero-copy > * {
				animation: fade-in-up 0.8s var(--ease-soft) both;
			}
			.hero-copy > :nth-child(2) {
				animation-delay: 0.1s;
			}
			.hero-copy > :nth-child(3) {
				animation-delay: 0.2s;
			}
			.hero-copy > :nth-child(4) {
				animation-delay: 0.3s;
			}
			.hero-kicker {
				margin: 0 0 1.1rem;
				font-family: var(--font-meta);
				font-size: 0.74rem;
				letter-spacing: 0.24em;
				text-transform: uppercase;
				color: oklch(1 0 0 / 0.72);
			}
			.hero h1 {
				margin: 0 0 0.45em;
				font-size: clamp(2.5rem, 1.3rem + 5vw, 5.2rem);
				line-height: 1.1;
				letter-spacing: -0.02em;
				color: #fff;
				word-break: keep-all;
				text-wrap: balance;
				text-shadow: 0 2px 30px oklch(0.1 0.03 268 / 0.45);
			}
			.hero .lead {
				margin: 0 0 2.2rem;
				font-size: clamp(1rem, 0.9rem + 0.45vw, 1.22rem);
				letter-spacing: 0.14em;
				color: oklch(1 0 0 / 0.84);
				word-break: keep-all;
			}
			/* 日文两行（署名 + 右侧落款）用明朝体：竖排时楷体是错的气质 */
			.hero .lead,
			.hero-vert {
				font-family: 'Shippori Mincho Subset', var(--font-body);
				font-weight: 500;
			}
			/* 打字机光标：挂在正在敲的那行末尾，敲完由 JS 摘除 */
			.type-caret {
				display: inline-block;
				width: 3px;
				min-width: 2px;
				height: 0.95em;
				margin-left: 0.12em;
				vertical-align: -0.08em;
				background: currentColor;
				animation: caret-blink 0.9s steps(1) infinite;
			}
			@keyframes caret-blink {
				0%, 100% { opacity: 1; }
				50% { opacity: 0; }
			}
			@media (prefers-reduced-motion: reduce) {
				.type-caret { display: none; }
			}
			.hero-actions {
				display: flex;
				align-items: center;
				gap: 1.6rem;
				flex-wrap: wrap;
			}
			.hero .btn-primary {
				background: #fff;
				color: oklch(0.22 0.03 268);
			}
			.hero .btn-primary:hover {
				background: oklch(0.93 0.035 var(--hue-accent));
				color: oklch(0.22 0.03 268);
			}
			.hero-link {
				color: oklch(1 0 0 / 0.86);
				font-size: 0.95rem;
				text-decoration: underline;
				text-decoration-color: oklch(1 0 0 / 0.4);
				text-underline-offset: 0.35em;
			}
			.hero-link:hover {
				color: #fff;
				text-decoration-color: #fff;
			}
			/* 右侧竖排：团名做落款，只在宽屏出现 */
			.hero-vert {
				position: absolute;
				z-index: 1;
				top: calc(64px + 3.5rem);
				right: max(1.25rem, calc(50vw - 550px));
				margin: 0;
				writing-mode: vertical-rl;
				font-size: 0.86rem;
				letter-spacing: 0.5em;
				color: oklch(1 0 0 / 0.7);
				animation: fade-in-up 1s var(--ease-soft) 0.5s both;
			}
			.hero-vert .tcy {
				text-combine-upright: all;
				letter-spacing: 0;
			}
			/* 25時（本地 0—5 点）：落款点亮。类由 JS 挂在 <html> 上。 */
			.hero-vert {
				transition: color 1.2s ease, text-shadow 1.2s ease;
			}
			:global(html.late-night) .hero-vert {
				color: oklch(0.9 0.055 var(--hue-accent));
				text-shadow:
					0 0 3px oklch(0.95 0.03 var(--hue-accent) / 0.8),
					0 0 16px oklch(0.66 0.11 var(--hue-accent) / 0.55);
			}
			.hero-foot {
				display: flex;
				align-items: center;
				gap: 0.6rem 1.6rem;
				flex-wrap: wrap;
				padding: 0.7rem 0 0.9rem;
				border-top: 1px solid oklch(1 0 0 / 0.24);
			}
			.player-chip {
				display: inline-flex;
				align-items: center;
				gap: 0.7rem;
				margin: 0;
			}
			.player-chip img {
				width: 34px;
				height: 34px;
				border-radius: 50%;
				object-fit: cover;
				margin: 0;
				box-shadow: 0 0 0 1px oklch(1 0 0 / 0.4);
			}
			.pc-name {
				display: inline-flex;
				align-items: center;
				gap: 0.45em;
				font-size: 0.86rem;
				font-weight: 700;
				letter-spacing: 0.08em;
			}
			.pc-role {
				font-family: var(--font-meta);
				font-size: 0.74rem;
				color: oklch(1 0 0 / 0.68);
			}
			.pc-dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: oklch(0.78 0.16 150);
			}
			.music-chip {
				display: inline-flex;
				align-items: center;
				gap: 0.55em;
				min-height: var(--tap-min);
				padding: 0 0.2rem;
				border: none;
				background: none;
				color: oklch(1 0 0 / 0.86);
				font: inherit;
				font-size: 0.86rem;
				cursor: var(--cursor-pointer);
			}
			.music-chip b {
				font-weight: 700;
				color: #fff;
				border-bottom: 1px solid oklch(1 0 0 / 0.45);
				transition: border-color var(--dur-fast) ease;
			}
			.music-chip:hover b {
				border-color: #fff;
			}
			.music-chip .note {
				animation: note-pulse 1.8s ease-in-out infinite;
			}
			@keyframes note-pulse {
				0%,
				100% {
					transform: scale(1);
					opacity: 1;
				}
				50% {
					transform: scale(1.18);
					opacity: 0.72;
				}
			}
			.foot-sep {
				width: 1px;
				height: 1.1rem;
				background: oklch(1 0 0 / 0.28);
			}
			.scroll-hint {
				margin-left: auto;
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				min-height: var(--tap-min);
				font-family: var(--font-meta);
				font-size: 0.7rem;
				letter-spacing: 0.24em;
				text-transform: uppercase;
				text-decoration: none;
				color: oklch(1 0 0 / 0.7);
			}
			.scroll-hint:hover {
				color: #fff;
			}
			.scroll-hint svg {
				animation: bounce-down 1.8s ease-in-out infinite;
			}

			/* ============ 运行状态条 ============
			   一条被发丝线收住的仪表行，不再是压在 Hero 上的玻璃卡。
			   访客脚本认 .now-visitors / #now-visitors / #week-visitors。 */
			.status {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				align-items: end;
				gap: 1.8rem 3rem;
				padding: 2.6rem 0 2.4rem;
				border-bottom: var(--rule);
			}
			.status-title {
				display: flex;
				align-items: center;
				gap: 0.65em;
				margin: 0;
				font-size: 1.4rem;
				font-weight: 700;
				letter-spacing: -0.01em;
			}
			.now-lead {
				margin: 0.4rem 0 0;
				color: var(--ink-soft);
			}
			.status-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.2rem 1.4rem;
				margin-top: 0.9rem;
				font-family: var(--font-meta);
				font-size: 0.76rem;
				letter-spacing: 0.06em;
				color: var(--muted);
			}
			.status-meta p {
				margin: 0;
			}
			.status-meta b,
			.status-meta :global(time) {
				color: var(--ink-soft);
				font-weight: 600;
			}
			/* 运行指示灯。外圈呼吸式扩散表示"在跑"，减少动效时只留静态的实心点。 */
			.now-dot {
				position: relative;
				flex: none;
				width: 9px;
				height: 9px;
				border-radius: 50%;
				background: oklch(0.72 0.16 150);
			}
			.now-dot::after {
				content: '';
				position: absolute;
				inset: -4px;
				border-radius: 50%;
				border: 1px solid oklch(0.72 0.16 150 / 0.55);
				animation: now-ping 2.6s var(--ease-soft) infinite;
			}
			@keyframes now-ping {
				0% {
					transform: scale(0.55);
					opacity: 0.9;
				}
				70%,
				100% {
					transform: scale(2.2);
					opacity: 0;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.now-dot::after {
					animation: none;
					opacity: 0;
				}
			}
			.now-stats {
				display: grid;
				grid-template-columns: repeat(4, auto);
				margin: 0;
			}
			.stat {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				padding: 0 1.6rem;
				border-left: var(--rule);
			}
			.stat:last-child {
				padding-right: 0;
			}
			.stat dt {
				font-family: var(--font-meta);
				font-size: 0.72rem;
				letter-spacing: 0.14em;
				color: var(--muted);
			}
			.stat dd {
				margin: 0;
				font-family: var(--font-num);
				font-size: 2.5rem;
				font-weight: 700;
				line-height: 1;
				font-variant-numeric: tabular-nums;
				color: var(--ink);
			}

			.site-section {
				margin-top: 5rem;
			}

			/* ============ 精选：左右交替的图文跨栏 ============ */
			.feature-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 4.5rem;
			}
			.feature {
				display: grid;
				grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
				gap: 2.8rem;
				align-items: center;
				text-decoration: none;
				color: inherit;
			}
			.feature-list > li:nth-child(even) .feature-media {
				order: 2;
			}
			.feature-media {
				position: relative;
				aspect-ratio: 16 / 10;
				overflow: hidden;
				border-radius: var(--r-media);
				background: var(--primary-ghost);
			}
			.feature-media :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform var(--dur-slow) var(--ease-soft);
			}
			.feature:hover .feature-media :global(img) {
				transform: scale(1.03);
			}
			.media-fallback {
				display: grid;
				place-items: center;
				height: 100%;
				font-size: 3rem;
				font-weight: 700;
				color: var(--primary);
			}
			.feature-meta {
				display: flex;
				align-items: center;
				gap: 0.9rem;
				margin: 0 0 1rem;
				font-family: var(--font-meta);
				font-size: 0.74rem;
				letter-spacing: 0.12em;
				color: var(--muted);
			}
			.feature h3 {
				margin: 0 0 0.35rem;
				font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.25rem);
				line-height: 1.2;
				transition: color var(--dur-fast) ease;
			}
			.feature:hover h3 {
				color: var(--primary);
			}
			.feature-sub {
				margin: 0 0 1rem;
				color: var(--primary);
				font-size: 0.95rem;
			}
			.feature-desc {
				margin: 0 0 1.2rem;
				color: var(--ink-soft);
				font-size: 0.95rem;
				line-height: 1.85;
			}
			.tech {
				display: flex;
				flex-wrap: wrap;
				gap: 0.2rem 0.55rem;
			}
			.go {
				display: inline-flex;
				align-items: center;
				gap: 0.45em;
				margin-top: 1.4rem;
				padding-bottom: 2px;
				border-bottom: 1px solid currentColor;
				font-size: 0.9rem;
				color: var(--ink);
				transition: gap var(--dur-fast) var(--ease-soft), color var(--dur-fast) ease;
			}
			.feature:hover .go,
			.coming:hover .go {
				gap: 0.8em;
				color: var(--primary);
			}

			/* ============ 制作中 ============ */
			.coming {
				display: block;
				text-decoration: none;
				color: inherit;
			}
			.coming-media {
				overflow: hidden;
				border-radius: var(--r-media);
				border: var(--rule);
				background: #fff;
			}
			.coming-media :global(img) {
				width: 100%;
				height: auto;
				display: block;
			}
			.coming-caption {
				display: grid;
				grid-template-columns: auto minmax(0, 1fr) auto;
				align-items: baseline;
				gap: 0.3rem 1.4rem;
				padding: 1.1rem 0 0;
			}
			.coming-caption h3 {
				margin: 0;
				font-size: 1.35rem;
				display: flex;
				align-items: center;
				gap: 0.8rem;
			}
			.coming-caption p {
				margin: 0;
				color: var(--ink-soft);
				font-size: 0.92rem;
			}
			.coming-caption .go {
				margin: 0;
			}

			/* ============ 最新文章：编号索引 ============ */
			.post-index {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-row {
				display: grid;
				grid-template-columns: 2.4rem 8.5rem minmax(0, 1fr) auto;
				grid-template-areas: 'idx date body arrow';
				align-items: baseline;
				gap: 0.2rem 1.2rem;
				padding: 1.3rem 0;
				border-bottom: var(--rule);
				text-decoration: none;
				color: inherit;
			}
			.post-index > li:first-child .post-row {
				padding-top: 0.2rem;
			}
			.post-row .idx {
				grid-area: idx;
				font-family: var(--font-num);
				font-size: 0.85rem;
				color: var(--primary);
			}
			.post-row .date {
				grid-area: date;
				margin: 0;
				font-family: var(--font-meta);
				font-size: 0.78rem;
				color: var(--muted);
				white-space: nowrap;
			}
			.post-row .body {
				grid-area: body;
				min-width: 0;
			}
			.post-row h3 {
				margin: 0;
				font-size: 1.12rem;
				line-height: 1.5;
				transition: color var(--dur-fast) ease;
			}
			.post-row .desc {
				margin: 0.3rem 0 0;
				font-size: 0.88rem;
				color: var(--muted);
				line-height: 1.7;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.post-row .arrow {
				grid-area: arrow;
				color: var(--muted);
				transition: transform var(--dur-fast) var(--ease-soft), color var(--dur-fast) ease;
			}
			.post-row:hover h3,
			.post-row:hover .arrow {
				color: var(--primary);
			}
			.post-row:hover .arrow {
				transform: translateX(4px);
			}

			@media (max-width: 860px) {
				.status {
					grid-template-columns: minmax(0, 1fr);
					padding-top: 2rem;
				}
				.now-stats {
					grid-template-columns: repeat(4, minmax(0, 1fr));
				}
				.stat {
					padding: 0 0.9rem;
				}
				.stat:first-child {
					border-left: none;
					padding-left: 0;
				}
				.stat dd {
					font-size: 1.9rem;
				}
				.feature {
					grid-template-columns: minmax(0, 1fr);
					gap: 1.4rem;
				}
				.feature-list > li:nth-child(even) .feature-media {
					order: 0;
				}
				.feature-list {
					gap: 3.5rem;
				}
			}
			@media (max-width: 720px) {
				.hero {
					margin-top: -56px;
					min-height: 88vh;
				}
				.hero-inner {
					padding-top: calc(56px + 3rem);
				}
				.hero-vert,
				.foot-sep,
				.scroll-hint {
					display: none;
				}
				.hero-foot {
					gap: 0.2rem 1.2rem;
				}
				.site-section {
					margin-top: 3.8rem;
				}
				.coming-caption {
					grid-template-columns: minmax(0, 1fr) auto;
				}
				.coming-caption p {
					grid-column: 1 / -1;
					grid-row: 2;
				}
				.post-row {
					grid-template-columns: 2rem minmax(0, 1fr) auto;
					grid-template-areas:
						'idx date arrow'
						'idx body arrow';
					gap: 0.25rem 0.8rem;
				}
				.post-row .desc {
					white-space: normal;
					display: -webkit-box;
					-webkit-line-clamp: 2;
					-webkit-box-orient: vertical;
				}
			}
		</style>
	</head>
	<body>
		<Header overHero />
		<main class="container" id="main-content" tabindex="-1">
			<section class="hero">
				<div class="hero-photo" aria-hidden="true">
					<Image
						src={HeroBg}
						alt=""
						widths={[640, 960, 1440, 2048]}
						sizes="100vw"
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
				<p class="hero-vert" aria-hidden="true"><span class="tcy">25</span>時、ナイトコードで。</p>
				<div class="hero-inner">
					<div class="hero-copy">
						<p class="hero-kicker">Lapismind · SEKAI</p>
						<h1>谢谢你，找到了我。</h1>
						<p class="lead">見つけてくれて、ありがとう —— 朝比奈真冬</p>
						<div class="hero-actions">
							<a class="btn btn-primary" href="/projects/">进来坐坐 <span aria-hidden="true">→</span></a>
							<a class="hero-link" href={GITHUB_URL} target="_blank" rel="noopener">GitHub ↗</a>
						</div>
					</div>
					<div class="hero-foot">
						<p class="player-chip" aria-label="Lapismind 玩家档案：在线">
							<img src={Mascot.src} alt="" width="34" height="34" />
							<span class="pc-name">LAPISMIND <span class="pc-dot" title="在线"></span></span>
							<span class="pc-role">独立开发者 · LV.1</span>
						</p>
						<span class="foot-sep" aria-hidden="true"></span>
						<button class="music-chip" id="md-open-chip" type="button">
							<svg class="note" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
								><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"></path
							></svg>
							<span>今日箱曲</span>
							<b>バグ</b>
						</button>
						<a class="scroll-hint" href="#featured">
							scroll
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
								stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
								><path d="M6 9l6 6 6-6"></path
							></svg>
						</a>
					</div>
				</div>
			</section>

			<section class="status reveal" aria-label="运行状态">
				<div>
					<p class="status-title">
						<span class="now-dot" aria-hidden="true"></span>
						SEKAI is running
					</p>
					<p class="now-lead">现在，我将演示 SEKAI 运行的框架。</p>
					<div class="status-meta">
						<p class="late-time" id="late-time" hidden>
							现在是 <b>--:--</b>
						</p>
						<p>最近更新 <FormattedDate date={latestPost.data.pubDate} /></p>
						<p class="now-visitors" hidden>
							今夜来访 <b id="now-visitors">—</b> 人 · 七日 <b id="week-visitors">—</b> 人
						</p>
					</div>
				</div>
				<dl class="now-stats">
					<div class="stat"><dt>游戏</dt><dd>{games.length}</dd></div>
					<div class="stat"><dt>已上线</dt><dd>{onlineCount}</dd></div>
					<div class="stat"><dt>曲库</dt><dd>{songs.length}</dd></div>
					<div class="stat"><dt>文章</dt><dd>{allPosts.length}</dd></div>
				</dl>
			</section>

			<section class="site-section" id="featured">
				<header class="sec-head reveal">
					<span class="sec-no">01</span>
					<h2>SEKAI 精选</h2>
					<span class="sec-en">selected</span>
					<div class="sec-links">
						<a class="more-link" href="/projects/">全部游戏 →</a>
						<a class="more-link" href="/works/">全部 Projects →</a>
					</div>
				</header>
				<ol class="feature-list">
					{
						featured.map((p) => (
							<li class="reveal">
								<a class="feature" href={p.href}>
									<div class="feature-media">
										{projectImages[p.slug] ? (
											<Image class="img-fade" src={projectImages[p.slug]} alt={`${p.name} 封面`} widths={[480, 760, 1100]} sizes="(max-width: 860px) 92vw, 640px" />
										) : (
											<div class="media-fallback">{p.name.slice(0, 1)}</div>
										)}
									</div>
									<div>
										<p class="feature-meta">
											<span>{p.kind}</span>
											<span class={`status-badge status-${p.status}`}>
												{p.version ?? (p.status === 'online' ? 'online' : '开发中')}
											</span>
										</p>
										<h3>{p.name}</h3>
										<p class="feature-sub">{p.subtitle}</p>
										<p class="feature-desc">{p.description}</p>
										<div class="tech">
											{p.tech.map((t) => <span class="tag">{t}</span>)}
										</div>
										<span class="go">查看详情 <span aria-hidden="true">→</span></span>
									</div>
								</a>
							</li>
						))
					}
				</ol>
			</section>

			<section class="site-section" id="coming">
				<header class="sec-head reveal">
					<span class="sec-no">02</span>
					<h2>is coming.</h2>
					<span class="sec-en">in production</span>
				</header>
				<a class="coming reveal" href="/projects/niigo-party/">
					<div class="coming-media">
						<Image src={NiigoPartyLineup} alt="niigo-party 立绘阵容" />
					</div>
					<div class="coming-caption">
						<h3>niigo-party <span class="status-badge status-developing">开发中</span></h3>
						<p>25時、ナイトコードで。 四人回合制派对游戏</p>
						<span class="go">去看看 <span aria-hidden="true">→</span></span>
					</div>
				</a>
			</section>

			<section class="site-section">
				<header class="sec-head reveal">
					<span class="sec-no">03</span>
					<h2>最新博客</h2>
					<span class="sec-en">journal</span>
					<div class="sec-links">
						<a class="more-link" href="/blog/">全部文章 →</a>
					</div>
				</header>
				<ol class="post-index">
					{
						posts.map((post, i) => (
							<li class="reveal" style={`--reveal-delay:calc(var(--stagger) * ${i})`}>
								<a class="post-row" href={`/blog/${post.id}/`}>
									<span class="idx">{pad2(i + 1)}</span>
									<p class="date"><FormattedDate date={post.data.pubDate} /></p>
									<div class="body">
										<h3>{post.data.title}</h3>
										<p class="desc">{post.data.description}</p>
									</div>
									<span class="arrow" aria-hidden="true">→</span>
								</a>
							</li>
						))
					}
				</ol>
			</section>
		</main>
		<Footer />
		<Live2dMascot />

	</body>
</html>

<script>
	// Hero 打字机：等进站开屏结束（没有开屏就直接开始）后，
	// h1 → lead 逐字敲出；标点带停顿、字速带抖动，模拟真人节奏。
	// HTML 里始终是完整原文（SEO / 无 JS 可读），敲字由 JS 接管。
	const TYPE_PAUSE: Record<string, number> = {
		'，': 420, '、': 380, '。': 560, '！': 560, '？': 560, ' ': 90,
	};
	function sleep(ms: number) {
		return new Promise((r) => setTimeout(r, ms));
	}
	function typeText(el: HTMLElement, speed = 115) {
		return new Promise<void>((resolve) => {
			const text = el.dataset.type ?? el.textContent ?? '';
			el.dataset.type = text;
			el.textContent = '';
			el.setAttribute('aria-label', text);
			const caret = document.createElement('span');
			caret.className = 'type-caret';
			el.appendChild(caret);
			let i = 0;
			function step() {
				if (i >= text.length) {
					caret.remove();
					resolve();
					return;
				}
				// 长破折号「——」整体敲出
				const chunk = text.slice(i, i + 2) === '——' ? 2 : 1;
				const ch = text[i];
				el.insertBefore(document.createTextNode(text.slice(i, i + chunk)), caret);
				let d = speed * (0.75 + Math.random() * 0.5);
				d += TYPE_PAUSE[ch] ?? 0;
				if (chunk === 2) d += 480;
				i += chunk;
				setTimeout(step, d);
			}
			step();
		});
	}
	async function waitIntroGone() {
		// 开屏最长 6.6s 自动清场；每 100ms 看一眼，最多等 8s
		for (let i = 0; i < 80; i++) {
			const el = document.getElementById('intro');
			if (!el || el.classList.contains('exit')) return;
			await sleep(100);
		}
	}
	async function typeHero() {
		const h1 = document.querySelector<HTMLElement>('.hero h1');
		const lead = document.querySelector<HTMLElement>('.hero .lead');
		if (!h1 || !lead || h1.dataset.typeDone) return;
		h1.dataset.typeDone = '1';
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		await waitIntroGone();
		await sleep(350);
		await typeText(h1);
		await sleep(320);
		await typeText(lead, 105);
	}
	document.addEventListener('astro:page-load', typeHero);
	typeHero();

	// 今夜来访：同源 Worker 接口查 Web Analytics RUM 数据。
	// 未配置（404）或失败时整行隐藏，不留占位符。
	async function loadVisitors() {
		const line = document.querySelector<HTMLElement>('.now-visitors');
		const el = document.getElementById('now-visitors');
		if (!line || !el) return;
		try {
			const r = await fetch('/api/visits');
			if (!r.ok) throw new Error(String(r.status));
			const d = await r.json();
			if (!d.ok) throw new Error('no-data');
			document.getElementById('week-visitors')!.textContent = String(d.week.visits);
			el.textContent = String(d.today.visits);
			line.hidden = false;
		} catch {
			line.hidden = true;
		}
	}
	document.addEventListener('astro:page-load', loadVisitors);
	loadVisitors();

	// 25 時：本地时间 0—5 点算作"夜里"，0—4 点的钟点按箱区习惯写成 24—28 时。
	// 状态条里亮出"现在是 25:14"，Hero 落款点亮（CSS 认 html.late-night）。
	let lateTimer = 0;
	function updateLateNight() {
		const root = document.documentElement;
		const el = document.getElementById('late-time');
		if (!el && !root.classList.contains('late-night')) return;
		const now = new Date();
		const h = now.getHours();
		const late = h < 5;
		root.classList.toggle('late-night', late);
		if (!el) return;
		if (late) {
			el.querySelector('b')!.textContent =
				`${h + 24}:${String(now.getMinutes()).padStart(2, '0')}`;
			el.hidden = false;
		} else {
			el.hidden = true;
		}
	}
	function initLateNight() {
		if (lateTimer) window.clearInterval(lateTimer);
		updateLateNight();
		lateTimer = window.setInterval(updateLateNight, 30_000);
	}
	document.addEventListener('astro:page-load', initLateNight);
	initLateNight();
</script>
